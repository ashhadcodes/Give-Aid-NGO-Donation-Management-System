@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.ContactPageViewModel
@{
    ViewData["Title"] = "Contact Give-AID - Direct Assistance & Helplines";
    var settings = Model.SiteSettings ?? new Dictionary<string, string>();
    var phone = settings.TryGetValue("ContactPhone", out var pVal) && !string.IsNullOrWhiteSpace(pVal) ? pVal : "+92-51-111-448-324";
    var email = settings.TryGetValue("ContactEmail", out var eVal) && !string.IsNullOrWhiteSpace(eVal) ? eVal : "contact@giveaid.org";
    var address = settings.TryGetValue("OfficeAddress", out var aVal) && !string.IsNullOrWhiteSpace(aVal) ? aVal : "Give-AID Tower, Sector G-8 Markaz, Islamabad, Pakistan";
}

<!-- Hero Banner -->
<div class="hero-wrapper py-4 py-md-5 text-center position-relative">
    <div class="hero-mesh-overlay"></div>
    <div class="container position-relative" style="z-index: 2;">
        <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill mb-2 fw-bold">
            <i class="bi bi-chat-dots-fill text-dark me-1"></i> 24/7 Response Desk
        </span>
        <h1 class="display-5 fw-bolder mb-2 text-dark">We Are Here For You</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0 fs-6">
            Have questions about partnering, volunteering, receipt verification, or donation traceability? Reach out to us.
        </p>
    </div>
</div>

<div class="container my-4 my-md-5">
    <div class="row g-4 g-lg-5">
        <!-- Contact Information & Map -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5 mb-4 rounded-4">
                <h4 class="fw-bold text-primary mb-4"><i class="bi bi-geo-alt-fill me-2"></i> Headquarters & Helplines</h4>

                <div class="d-flex gap-3 mb-4 align-items-start">
                    <div class="p-3 bg-success bg-opacity-10 rounded-3 text-success fs-4 flex-shrink-0">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Office Location</h6>
                        <p class="text-muted small mb-0">@address</p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4 align-items-start">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary fs-4 flex-shrink-0">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Direct Helpline</h6>
                        <p class="text-muted small mb-0 fw-bold">@phone</p>
                        <small class="text-muted">Mon - Sat: 9:00 AM - 6:00 PM PKT</small>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4 align-items-start">
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning fs-4 flex-shrink-0">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Official Email</h6>
                        <p class="text-muted small mb-0">@email</p>
                    </div>
                </div>

                <hr class="my-4 opacity-50" />

                <h6 class="fw-bold mb-3">Connect On Social Channels</h6>
                <div class="d-flex gap-3 fs-5">
                    <a href="https://facebook.com" target="_blank" class="footer-social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="https://twitter.com" target="_blank" class="footer-social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="https://instagram.com" target="_blank" class="footer-social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="https://linkedin.com" target="_blank" class="footer-social-icon" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5 rounded-4">
                <h3 class="fw-bold mb-2">Send Us a Direct Message</h3>
                <p class="text-muted small mb-4">Fill out the form below and our coordinators will get back to you within 24 operational hours.</p>

                <form asp-controller="Contact" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Form.Name" class="form-label fw-semibold"></label>
                            <input asp-for="Form.Name" class="form-control" placeholder="Your Full Name" />
                            <span asp-validation-for="Form.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.Email" class="form-label fw-semibold"></label>
                            <input asp-for="Form.Email" class="form-control" placeholder="your.email@example.com" />
                            <span asp-validation-for="Form.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Form.Phone" class="form-control" placeholder="03XXXXXXXXX" />
                            <span asp-validation-for="Form.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.Subject" class="form-label fw-semibold"></label>
                            <input asp-for="Form.Subject" class="form-control" placeholder="Subject of inquiry" />
                            <span asp-validation-for="Form.Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Form.Message" class="form-label fw-semibold"></label>
                            <textarea asp-for="Form.Message" class="form-control" rows="5" placeholder="Write your detailed message here..."></textarea>
                            <span asp-validation-for="Form.Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                <i class="bi bi-send-fill me-2"></i> Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
