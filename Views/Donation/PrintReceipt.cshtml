@model Give_Aid_NGO_Donation_Management_System.Models.Entities.Donation
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Official Receipt - @(Model.Receipt?.ReceiptNumber ?? Model.TransactionReference)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #212529;
            background: #f8fafc;
            padding: 20px 10px;
        }
        .receipt-card {
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 25px;
        }
        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .receipt-card {
                border: none;
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="text-center mb-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4">
            <i class="bi bi-printer me-1"></i> Print / Save as PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary ms-2">Close</button>
    </div>

    <div class="receipt-card">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-2 border-bottom pb-3 mb-3">
            <div>
                <h3 class="fw-bold text-success mb-0"><i class="bi bi-heart-pulse-fill"></i> Give-AID Welfare Trust</h3>
                <small class="text-muted d-block">Reg No: FBR-NGO-PK-99420-2026 | Sector G-8 Markaz, Islamabad</small>
                <small class="text-muted d-block">Helpline: +92-51-111-448-324 | contact@giveaid.org</small>
            </div>
            <div class="text-sm-end">
                <span class="badge bg-success fs-6">PAID & VERIFIED</span>
                <h5 class="fw-bold font-monospace mt-2 mb-0">@(Model.Receipt?.ReceiptNumber ?? $"REC-{Model.Id:D6}")</h5>
                <small class="text-muted d-block">Issued: @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded border h-100">
                    <strong class="text-muted small text-uppercase d-block mb-1">Donor Details:</strong>
                    <div class="fw-bold fs-6">@(Model.IsAnonymous ? "Anonymous Donor" : Model.DonorName)</div>
                    <div class="small text-muted">@Model.DonorEmail</div>
                    @if (!string.IsNullOrEmpty(Model.DonorPhone)) { <div class="small text-muted">@Model.DonorPhone</div> }
                    @if (!string.IsNullOrEmpty(Model.DonorCity)) { <div class="small text-muted">@Model.DonorCity, Pakistan</div> }
                </div>
            </div>
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded border h-100">
                    <strong class="text-muted small text-uppercase d-block mb-1">Transaction Details:</strong>
                    <div class="small"><strong>Gateway:</strong> @Model.PaymentMethod</div>
                    <div class="small text-truncate"><strong>Tx Ref:</strong> <code>@Model.TransactionReference</code></div>
                    <div class="small"><strong>Status:</strong> <span class="text-success fw-bold">Verified & Paid</span></div>
                </div>
            </div>
        </div>

        <div class="table-responsive mb-3">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cause / Designated Purpose</th>
                        <th>Category</th>
                        <th class="text-end" style="min-width: 140px;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>@(Model.Cause?.Title ?? "General Relief & Welfare Fund")</strong>
                            <div class="small text-muted">100% direct humanitarian deployment</div>
                        </td>
                        <td>@(Model.Cause?.Category ?? "Welfare")</td>
                        <td class="text-end fw-bold text-success">@Model.Currency @Model.Amount.ToString("N0")</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end fw-bold">Platform / Administrative Fee:</td>
                        <td class="text-end fw-bold">PKR 0</td>
                    </tr>
                    <tr class="table-active">
                        <td colspan="2" class="text-end fw-bold fs-5">Total Net Contribution:</td>
                        <td class="text-end fw-bold fs-5 text-success">@Model.Currency @Model.Amount.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(Model.DonorNotes))
        {
            <div class="p-2 bg-light rounded border mb-3 small text-muted fst-italic">
                <strong>Dedication Note:</strong> "@Model.DonorNotes"
            </div>
        }

        <div class="row align-items-center pt-3 border-top g-2">
            <div class="col-sm-8">
                <small class="text-muted d-block"><strong>Digital Signature Hash:</strong></small>
                <code class="small text-break">@(Model.Receipt?.DigitalSignature ?? "SHA256-VERIFIED")</code>
            </div>
            <div class="col-sm-4 text-sm-end">
                <div class="fw-bold small">Authorized Representative</div>
                <small class="text-muted">Give-AID Oversight</small>
            </div>
        </div>
    </div>
</body>
</html>
