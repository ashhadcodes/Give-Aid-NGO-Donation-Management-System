@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4 py-md-5">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-3 sticky-lg-top" style="top: 90px;">
                <h6 class="text-uppercase text-muted fw-bold px-3 py-2 small mb-1">Account Menu</h6>
                <div class="nav flex-column nav-pills gap-1">
                    <a class="nav-link" asp-controller="Account" asp-action="Dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Overview</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyDonations"><i class="bi bi-receipt me-2"></i> My Donations</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyInterests"><i class="bi bi-calendar-check me-2"></i> Programme Interests</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyQueries"><i class="bi bi-chat-dots me-2"></i> My Queries</a>
                    <a class="nav-link" asp-controller="Account" asp-action="InviteFriend"><i class="bi bi-person-plus-fill me-2"></i> Invite Friends</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-lines-fill me-2"></i> Edit Profile</a>
                    <a class="nav-link active" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key-fill me-2"></i> Change Password</a>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-lg p-3 p-sm-4 p-md-5">
                <h3 class="fw-bold mb-1 text-primary">Change Password</h3>
                <p class="text-muted small mb-4">Ensure your account uses a strong, unique password.</p>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                        <i class="bi bi-shield-check me-1"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
