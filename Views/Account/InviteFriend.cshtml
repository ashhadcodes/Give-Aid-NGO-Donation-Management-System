@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.InviteFriendViewModel
@{
    ViewData["Title"] = "Invite a Friend to Give-AID";
}

<div class="container py-4 py-md-5">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-3 sticky-lg-top" style="top: 90px;">
                <h6 class="text-uppercase text-muted fw-bold px-3 py-2 small mb-1">Account Menu</h6>
                <div class="nav flex-column nav-pills gap-1">
                    <a class="nav-link" asp-controller="Account" asp-action="Dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Overview</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyDonations"><i class="bi bi-receipt me-2"></i> My Donations</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyInterests"><i class="bi bi-calendar-check me-2"></i> Programme Interests</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyQueries"><i class="bi bi-chat-dots me-2"></i> My Queries</a>
                    <a class="nav-link active" asp-controller="Account" asp-action="InviteFriend"><i class="bi bi-person-plus-fill me-2"></i> Invite Friends</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-lines-fill me-2"></i> Edit Profile</a>
                    <a class="nav-link" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key-fill me-2"></i> Change Password</a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-envelope-heart-fill fs-1 text-success mb-2"></i>
                    <h3 class="fw-bold mb-1">Invite a Friend to Give-AID</h3>
                    <p class="text-muted small">Multiply your impact! Invite colleagues and family members to join our welfare community.</p>
                </div>

                <form asp-controller="Account" asp-action="InviteFriend" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FriendName" class="form-label fw-semibold"></label>
                            <input asp-for="FriendName" class="form-control" placeholder="Friend's Full Name" />
                            <span asp-validation-for="FriendName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FriendEmail" class="form-label fw-semibold"></label>
                            <input asp-for="FriendEmail" class="form-control" placeholder="friend@example.com" />
                            <span asp-validation-for="FriendEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label fw-semibold"></label>
                            <textarea asp-for="Message" class="form-control" rows="4" placeholder="Optional personal note to your friend..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 shadow-sm">
                                <i class="bi bi-send-fill me-2"></i> Send Official Invitation Email
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
