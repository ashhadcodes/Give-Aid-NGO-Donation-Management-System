@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.SupportQuery>
@{
    ViewData["Title"] = "My Support Queries";
}

<div class="container py-4 py-md-5">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-3 sticky-lg-top" style="top: 90px;">
                <h6 class="text-uppercase text-muted fw-bold px-3 py-2 small mb-1">Account Menu</h6>
                <div class="nav flex-column nav-pills gap-1">
                    <a class="nav-link" asp-controller="Account" asp-action="Dashboard"><i class="bi bi-grid-1x2-fill me-2"></i> Overview</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyDonations"><i class="bi bi-receipt me-2"></i> My Donations</a>
                    <a class="nav-link" asp-controller="Account" asp-action="MyInterests"><i class="bi bi-calendar-check me-2"></i> Programme Interests</a>
                    <a class="nav-link active" asp-controller="Account" asp-action="MyQueries"><i class="bi bi-chat-dots me-2"></i> My Queries</a>
                    <a class="nav-link" asp-controller="Account" asp-action="InviteFriend"><i class="bi bi-person-plus-fill me-2"></i> Invite Friends</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-lines-fill me-2"></i> Edit Profile</a>
                    <a class="nav-link" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key-fill me-2"></i> Change Password</a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                    <div>
                        <h3 class="fw-bold mb-1 text-primary">My Support Queries</h3>
                        <p class="text-muted small mb-0">Track responses and resolutions to queries you have submitted.</p>
                    </div>
                    <a asp-controller="HelpCentre" asp-action="Index" class="btn btn-primary btn-sm flex-shrink-0">
                        <i class="bi bi-plus-circle me-1"></i> New Query
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-chat-square-dots fs-1 text-muted d-block mb-3"></i>
                        <h5>No queries raised.</h5>
                        <p class="text-muted small">Need assistance? You can submit a support ticket anytime.</p>
                        <a asp-controller="HelpCentre" asp-action="Index" class="btn btn-outline-primary">Go to Help Centre</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var q in Model)
                        {
                            <div class="card border p-3 p-sm-4">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-2 mb-2">
                                    <div>
                                        <span class="badge bg-light text-dark border me-1">Ticket #@q.Id</span>
                                        <h5 class="fw-bold mb-1 d-inline">@q.Subject</h5>
                                    </div>
                                    <span class="badge @(q.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved ? "bg-success" : (q.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress ? "bg-info" : "bg-warning text-dark"))">
                                        @q.Status
                                    </span>
                                </div>
                                <small class="text-muted mb-3 d-block"><i class="bi bi-clock me-1"></i> Submitted on @q.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small>
                                
                                <div class="p-3 bg-light rounded mb-3">
                                    <strong>Your Message:</strong>
                                    <p class="mb-0 text-muted small mt-1">@q.Message</p>
                                </div>

                                @if (!string.IsNullOrEmpty(q.AdminResponse))
                                {
                                    <div class="p-3 bg-primary-subtle border-start border-primary border-4 rounded">
                                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-1 mb-1">
                                            <strong class="text-primary"><i class="bi bi-reply-fill"></i> Admin Official Response:</strong>
                                            @if (q.RespondedAt.HasValue)
                                            {
                                                <small class="text-muted">@q.RespondedAt.Value.ToString("dd MMM yyyy, HH:mm") UTC</small>
                                            }
                                        </div>
                                        <p class="mb-0 small" style="white-space: pre-line;">@q.AdminResponse</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted fst-italic">
                                        <i class="bi bi-hourglass-split me-1"></i> Our support team is currently reviewing your ticket.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
