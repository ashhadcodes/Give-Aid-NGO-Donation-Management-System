@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Account Login - Give-AID Portal";
}

<div class="container py-5 my-3">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8 col-12">
            <div class="card border-0 shadow-lg p-4 p-md-5 tilt-card-3d auth-card" style="border-radius: var(--radius-xl);">
                <div class="text-center mb-4 card-3d-depth-1">
                    <span class="brand-badge bg-success text-white px-3 py-1.5 rounded-pill fw-bold fs-6 mb-2 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse-fill"></i> Give-AID Member Portal
                    </span>
                    <h2 class="fw-bolder text-dark">Welcome Back</h2>
                    <p class="text-secondary small mb-0">Sign in to your member account or administration console.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="card-3d-depth-2">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope text-primary"></i></span>
                            <input asp-for="Email" class="form-control" id="loginEmailInput" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-semibold text-dark mb-0"></label>
                            <a asp-controller="Account" asp-action="ForgotPassword" class="small text-decoration-none text-warning">Forgot password?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock text-primary"></i></span>
                            <input asp-for="Password" class="form-control" id="loginPasswordInput" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary" for="rememberMeCheck">Remember my session</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 mb-3 shadow-sm btn-pulse">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In to Portal
                    </button>

                    <div class="p-3 rounded-3 text-center small text-secondary mb-3 border bg-light">
                        <strong class="text-dark d-block mb-2"><i class="bi bi-key-fill text-warning me-1"></i> Quick Test Credentials:</strong>
                        <div class="d-flex flex-wrap gap-1.5 justify-content-center">
                            <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 fill-cred-btn" data-email="admin@giveaid.org" data-pass="admin123">
                                <i class="bi bi-shield-lock-fill me-1"></i> Admin (admin123)
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm py-1 px-2 fill-cred-btn" data-email="superadmin@giveaid.org" data-pass="admin123">
                                <i class="bi bi-stars me-1"></i> SuperAdmin
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 fill-cred-btn" data-email="donor@giveaid.org" data-pass="admin123">
                                <i class="bi bi-person-fill me-1"></i> Donor
                            </button>
                        </div>
                    </div>

                    <div class="text-center small text-secondary">
                        Don't have an account yet? <a asp-controller="Account" asp-action="Register" class="fw-bold text-primary">Register new account</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.fill-cred-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('loginEmailInput').value = this.getAttribute('data-email');
                document.getElementById('loginPasswordInput').value = this.getAttribute('data-pass');
            });
        });
    </script>
}
