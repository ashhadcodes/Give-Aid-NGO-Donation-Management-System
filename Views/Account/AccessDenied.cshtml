@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="card border-0 shadow-lg p-5">
                <i class="bi bi-shield-x fs-1 text-danger mb-3"></i>
                <h2 class="fw-bold mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">You do not have the required administrative role permissions to view this resource.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-semibold">Return to Home</a>
                    <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-secondary">Member Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
