@model Give_Aid_NGO_Donation_Management_System.Models.Entities.NGO
@{
    ViewData["Title"] = Model.Name;
}

<!-- Hero Banner -->
<div class="hero-wrapper py-4 py-md-5 position-relative">
    <div class="hero-mesh-overlay"></div>
    <div class="container position-relative" style="z-index: 2;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Ngos" asp-action="Index" class="text-secondary text-decoration-none">NGOs</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row align-items-md-center gap-3 gap-md-4">
            <img src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=300&auto=format&fit=crop&q=80" : Model.LogoUrl)" 
                 class="rounded-circle bg-white p-1 shadow-lg border flex-shrink-0" style="width: 90px; height: 90px; object-fit: cover;" alt="@Model.Name">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-1 fw-bold"><i class="bi bi-patch-check-fill me-1"></i> Verified Partner NGO</span>
                <h1 class="display-5 fw-bolder mb-1 text-white">@Model.Name</h1>
                <p class="lead text-secondary mb-0 fs-6">Registration #: <strong>@(Model.RegistrationNumber ?? "NGO-Verified")</strong> &nbsp;|&nbsp; Operating Since: <strong>@Model.EstablishedYear</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="container my-4 my-md-5">
    <div class="row g-4">
        <!-- NGO Bio & Active Programmes -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-3 p-sm-4 p-md-5 mb-4 rounded-4">
                <h4 class="fw-bold mb-3 text-primary">About the Organization & Mission</h4>
                <p class="text-muted fs-6" style="white-space: pre-line; line-height: 1.8;">@Model.Description</p>

                <h4 class="fw-bold mt-5 mb-3 text-dark">Active Field Programmes by @Model.Name</h4>
                <div class="row g-3">
                    @if (Model.Programmes == null || !Model.Programmes.Any())
                    {
                        <div class="col-12 text-muted">
                            <p class="p-3 bg-light rounded-3 text-center mb-0">No active public programmes listed currently for this partner.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var prog in Model.Programmes)
                        {
                            <div class="col-md-6">
                                <div class="card border p-3.5 h-100 card-hover rounded-3">
                                    <span class="badge bg-primary-subtle text-primary align-self-start mb-2">@prog.Category</span>
                                    <h6 class="fw-bold mb-1">@prog.Title</h6>
                                    <small class="text-muted mb-3 d-block"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @prog.Location</small>
                                    <a asp-controller="Programmes" asp-action="Details" asp-route-id="@prog.Id" class="btn btn-sm btn-outline-primary mt-auto fw-bold">View Programme Details</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Official Contact Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-3 p-sm-4 sticky-lg-top rounded-4" style="top: 90px;">
                <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle-fill me-2"></i> NGO Contact Particulars</h5>
                
                <ul class="list-unstyled small d-flex flex-column gap-3 mb-4">
                    <li>
                        <strong class="d-block text-muted mb-1">Official Email</strong>
                        <a href="mailto:@Model.Email" class="text-decoration-none fw-semibold">@Model.Email</a>
                    </li>
                    <li>
                        <strong class="d-block text-muted mb-1">Helpline / Direct Phone</strong>
                        <span class="fw-semibold">@Model.Phone</span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <li>
                            <strong class="d-block text-muted mb-1">Official Website</strong>
                            <a href="@Model.Website" target="_blank" class="text-decoration-none fw-semibold">@Model.Website</a>
                        </li>
                    }
                    <li>
                        <strong class="d-block text-muted mb-1">Field Headquarters</strong>
                        <span class="fw-semibold">@Model.Address, @Model.City, @Model.Country</span>
                    </li>
                </ul>

                <a asp-controller="Donation" asp-action="Donate" class="btn btn-primary w-100 fw-bold py-3 shadow-sm btn-pulse">
                    <i class="bi bi-heart-fill text-danger me-1"></i> Donate to Welfare Funds
                </a>
            </div>
        </div>
    </div>
</div>
