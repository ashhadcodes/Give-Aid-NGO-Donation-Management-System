@{
    ViewData["Title"] = "Privacy & Security Policy";
}

<div class="bg-primary text-white py-5 mb-5 text-center">
    <div class="container">
        <h1 class="fw-bold mb-2">Privacy & Financial Security Policy</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-0">
            How Give-AID protects donor confidentiality, transaction security, and personal data.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <h4 class="fw-bold text-primary mb-3"><i class="bi bi-shield-check me-2"></i>1. Zero Financial Credential Storage</h4>
                <p>Give-AID adheres to international non-profit security standards. We <strong>never store, log, or cache</strong> sensitive payment details including credit card numbers, CVV codes, card PINs, JazzCash MPINs, or Easypaisa PINs on our servers. All transactions are routed directly through secured, encrypted payment gateway channels.</p>

                <h4 class="fw-bold text-primary mt-4 mb-3"><i class="bi bi-person-lock me-2"></i>2. Donor Privacy & Anonymity</h4>
                <p>Donors have the full autonomy to make anonymous contributions. When opting for anonymous giving, your identity is masked across public registers while maintaining an encrypted private receipt inside your member dashboard.</p>

                <h4 class="fw-bold text-primary mt-4 mb-3"><i class="bi bi-lock-fill me-2"></i>3. Data Encryption & HTTPS</h4>
                <p>All network communications, registration details, and donation records are transmitted over SSL/TLS 256-bit encrypted channels with secure HTTP-only cookies and anti-forgery tokens preventing Cross-Site Request Forgery (CSRF) and Cross-Site Scripting (XSS).</p>

                <h4 class="fw-bold text-primary mt-4 mb-3"><i class="bi bi-envelope-check me-2"></i>4. Email Communications</h4>
                <p>We use your registered email solely for dispatching official tax-exempt donation receipts, account verification, password resets, and responses to support queries you initiated.</p>

                <div class="alert alert-info mt-4 mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i> For privacy inquiries or data removal requests, please contact our Data Protection Officer at <a href="mailto:privacy@giveaid.org" class="fw-bold">privacy@giveaid.org</a>.
                </div>
            </div>
        </div>
    </div>
</div>
