@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Give-AID - Transparent Humanitarian Giving & NGO Network";
}

@section Styles {
    <link rel="stylesheet" href="~/css/frame-sequence.css" asp-append-version="true" />
}

<!-- ==========================================================================
     0. CINEMATIC FRAME-SEQUENCE HERO (pinned) — frames only + minimal copy
     Donation card intentionally lives in the NEXT section after pin release.
     ========================================================================== -->
<section id="cinematicSequence" class="cinematic-sequence" aria-label="Give-AID cinematic introduction">
    <div class="cinematic-sequence__stage">
        <canvas id="frameSequenceCanvas" class="cinematic-sequence__canvas" role="img" aria-label="Scroll-driven humanitarian visual sequence"></canvas>
        <div class="cinematic-sequence__veil" aria-hidden="true"></div>

        <div class="cinematic-sequence__loading" role="status" aria-live="polite">
            <span class="cinematic-sequence__loading-label" data-frame-loading-label>Preparing cinematic sequence…</span>
            <div class="cinematic-sequence__loading-track">
                <div class="cinematic-sequence__loading-bar" data-frame-loading-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
        </div>

        <div class="cinematic-sequence__overlay">
            <div class="cinematic-sequence__copy">
                <p class="cinematic-sequence__brand mb-0">Give-AID</p>
                <h1 class="cinematic-sequence__title">
                    Every Rupee <span>Reaches Those</span> in Critical Need.
                </h1>
                <p class="cinematic-sequence__lead">
                    Scroll to experience the journey — then give with full transparency.
                </p>
                <div class="cinematic-sequence__actions">
                    <a asp-controller="Donation" asp-action="Donate" class="btn btn-warning fw-bold px-4 text-dark shadow-sm">
                        <i class="bi bi-heart-fill text-danger me-2"></i> Donate
                    </a>
                </div>
            </div>
        </div>

        <div class="cinematic-sequence__scroll-hint" aria-hidden="true">
            <span>Scroll</span>
            <span class="hint-line"></span>
        </div>
    </div>
</section>

<!-- ==========================================================================
     1. QUICK GIVING + IMPACT (appears AFTER cinematic pin releases)
     ========================================================================== -->
<section id="quickGivingSection" class="hero-wrapper position-relative hero-impact-band donation-after-cinematic">
    <div class="hero-mesh-overlay"></div>

    <div class="container hero-content">
        <div class="row align-items-center g-4 g-lg-5 mb-4 mb-lg-5" data-donation-entrance>
            <div class="col-lg-6" data-aos="fade-up">
                <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-2">Ready to Give</span>
                <h2 class="display-6 fw-bold mb-2">Make an Instant Impact</h2>
                <p class="text-secondary mb-3 mb-lg-4">
                    Every contribution reaches verified fieldwork. Choose an amount below — JazzCash, Easypaisa, and cards supported.
                </p>
                <div class="d-flex flex-wrap gap-3 gap-sm-4 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="fw-semibold text-secondary">Instant Verifiable Receipt</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="fw-semibold text-secondary">0% Platform Deduction</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <div class="quick-donate-card tilt-card-3d">
                    <div class="d-flex justify-content-between align-items-center mb-3 card-3d-depth-1">
                        <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick 1-Click Giving
                        </span>
                        <small class="text-muted"><i class="bi bi-lock-fill text-success"></i> 256-Bit SSL</small>
                    </div>

                    <h4 class="fw-bold mb-1 card-3d-depth-1">Select Your Contribution</h4>
                    <p class="text-muted small mb-3 card-3d-depth-1">Pick an amount or enter a custom contribution to deploy relief immediately.</p>

                    <form asp-controller="Donation" asp-action="Donate" method="get" id="quickDonateHeroForm" class="card-3d-depth-2">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-2">Select Donation Amount (PKR)</label>
                        <div class="d-grid gap-2 mb-3" style="grid-template-columns: repeat(auto-fit, minmax(75px, 1fr));">
                            <div class="amount-chip" data-amount="1000">PKR 1,000</div>
                            <div class="amount-chip active" data-amount="2500">PKR 2,500</div>
                            <div class="amount-chip" data-amount="5000">PKR 5,000</div>
                            <div class="amount-chip" data-amount="10000">PKR 10,000</div>
                            <div class="amount-chip" data-amount="25000">PKR 25,000</div>
                            <div class="amount-chip" data-amount="50000">PKR 50,000</div>
                        </div>

                        <div class="input-group input-group-lg mb-3">
                            <span class="input-group-text fw-bold text-success border-end-0">PKR</span>
                            <input type="number" name="customAmount" id="heroCustomAmount" class="form-control fw-bold border-start-0" value="2500" min="10" step="10" placeholder="Custom Amount" />
                        </div>

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 bg-light rounded-3 mb-3 border">
                            <span class="small text-muted fw-semibold ps-1">Supported Gateways:</span>
                            <div class="d-flex flex-wrap gap-1.5">
                                <span class="badge payment-badge payment-jazzcash">JazzCash</span>
                                <span class="badge payment-badge payment-easypaisa">Easypaisa</span>
                                <span class="badge payment-badge payment-card">VISA/Master</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold text-dark py-3 shadow-sm btn-pulse">
                            <i class="bi bi-heart-fill text-danger me-2"></i> Proceed to Donate
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Real-Time Impact Counters -->
        <div class="row g-2 g-sm-3 g-md-4">
            <div class="col-6 col-lg-3" data-aos="zoom-in" data-aos-delay="100">
                <div class="stat-box-modern tilt-card-3d">
                    <div class="stat-icon card-3d-depth-2"><i class="bi bi-cash-stack"></i></div>
                    <h3 class="fw-bold mb-0 counter-value card-3d-depth-1" data-prefix="PKR " data-target="@Model.TotalDonationsRaised">PKR @Model.TotalDonationsRaised.ToString("N0")</h3>
                    <small class="text-muted text-uppercase fw-semibold">Funds Raised</small>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-aos="zoom-in" data-aos-delay="200">
                <div class="stat-box-modern tilt-card-3d">
                    <div class="stat-icon card-3d-depth-2"><i class="bi bi-people-fill"></i></div>
                    <h3 class="fw-bold mb-0 counter-value card-3d-depth-1" data-suffix="+" data-target="@Model.TotalPeopleHelped">@Model.TotalPeopleHelped.ToString("N0")+</h3>
                    <small class="text-muted text-uppercase fw-semibold">Lives Impacted</small>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-aos="zoom-in" data-aos-delay="300">
                <div class="stat-box-modern tilt-card-3d">
                    <div class="stat-icon card-3d-depth-2"><i class="bi bi-calendar-event-fill"></i></div>
                    <h3 class="fw-bold mb-0 counter-value card-3d-depth-1" data-target="@Model.TotalActiveProgrammes">@Model.TotalActiveProgrammes</h3>
                    <small class="text-muted text-uppercase fw-semibold">Active Programmes</small>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-aos="zoom-in" data-aos-delay="400">
                <div class="stat-box-modern tilt-card-3d">
                    <div class="stat-icon card-3d-depth-2"><i class="bi bi-buildings-fill"></i></div>
                    <h3 class="fw-bold mb-0 counter-value card-3d-depth-1" data-target="@Model.TotalPartnerNgos">@Model.TotalPartnerNgos</h3>
                    <small class="text-muted text-uppercase fw-semibold">Partner NGOs</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     2. 4-STEP TRANSPARENT TRACEABILITY JOURNEY ("HOW GIVE-AID WORKS")
     ========================================================================== -->
<section class="py-5 position-relative" style="background: var(--bg-surface-elevated);">
    <div class="container py-3 py-md-4">
        <div class="text-center max-w-2xl mx-auto mb-5" data-aos="fade-up">
            <span class="badge bg-success-subtle text-success fw-bold px-3 py-1.5 rounded-pill mb-2">Unmatched Integrity</span>
            <h2 class="display-6 fw-bold mb-2">How Give-AID Ensures 100% Traceability</h2>
            <p class="text-muted">From the moment you donate to on-ground execution, track every step of your impact in real time.</p>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                <div class="step-card h-100 tilt-card-3d">
                    <div class="step-number card-3d-depth-2">1</div>
                    <div class="step-icon card-3d-depth-2"><i class="bi bi-hand-index-thumb"></i></div>
                    <h5 class="fw-bold mb-2 card-3d-depth-1">Select a Cause</h5>
                    <p class="text-muted small mb-0 card-3d-depth-1">Browse verified campaigns in healthcare, education, clean water, or emergency food relief.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                <div class="step-card h-100 tilt-card-3d">
                    <div class="step-number card-3d-depth-2">2</div>
                    <div class="step-icon card-3d-depth-2"><i class="bi bi-shield-check"></i></div>
                    <h5 class="fw-bold mb-2 card-3d-depth-1">Secure Payment</h5>
                    <p class="text-muted small mb-0 card-3d-depth-1">Pay seamlessly via JazzCash, Easypaisa, or Debit/Credit Cards with 256-bit bank-grade encryption.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                <div class="step-card h-100 tilt-card-3d">
                    <div class="step-number card-3d-depth-2">3</div>
                    <div class="step-icon card-3d-depth-2"><i class="bi bi-receipt"></i></div>
                    <h5 class="fw-bold mb-2 card-3d-depth-1">Instant Receipt</h5>
                    <p class="text-muted small mb-0 card-3d-depth-1">A tamper-proof digital receipt with unique tracking ID & QR code is issued immediately.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="400">
                <div class="step-card h-100 tilt-card-3d">
                    <div class="step-number card-3d-depth-2">4</div>
                    <div class="step-icon card-3d-depth-2"><i class="bi bi-camera-video"></i></div>
                    <h5 class="fw-bold mb-2 card-3d-depth-1">Field Deployment</h5>
                    <p class="text-muted small mb-0 card-3d-depth-1">Partner NGOs execute the relief on ground and upload photos and progress reports directly to your portal.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. FEATURED WELFARE CAUSES (WITH 3D TILT EFFECT & PROGRESS METERS)
     ========================================================================== -->
<section class="py-5" style="background: var(--bg-body);">
    <div class="container py-3">
        <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-end gap-3 mb-4" data-aos="fade-up">
            <div>
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">Active Campaigns</span>
                <h2 class="display-6 fw-bold mb-1">Featured Welfare Causes</h2>
                <p class="text-muted mb-0">Targeted causes requiring urgent intervention. 100% of donations are deployed directly.</p>
            </div>
            <a asp-controller="Donation" asp-action="Index" class="btn btn-outline-primary fw-bold flex-shrink-0">
                View All Causes <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="card-grid-responsive">
            @foreach (var cause in Model.FeaturedCauses)
            {
                var percentage = cause.TargetAmount > 0 ? (int)Math.Min(100, Math.Round((cause.RaisedAmount / cause.TargetAmount) * 100)) : 0;
                <div class="cause-grid-item d-flex" data-aos="fade-up">
                    <div class="card h-100 w-100 card-hover tilt-card-3d border-0 shadow-sm cause-card">
                        <div class="position-relative card-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(cause.ImageUrl) ? "https://images.unsplash.com/photo-1532629345422-7515f3d16bb9?w=600&auto=format&fit=crop&q=80" : cause.ImageUrl)" 
                                 class="card-img-top" alt="@cause.Title" loading="lazy">
                            <div class="card-badge-overlay position-absolute top-0 start-0 end-0 d-flex justify-content-between align-items-start p-2.5">
                                <span class="badge bg-dark bg-opacity-80 text-white px-2.5 py-1 rounded-pill backdrop-blur">
                                    @cause.Category
                                </span>
                                @if (cause.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill shadow-sm">
                                        <i class="bi bi-fire text-danger"></i> Urgent
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-3 flex-grow-1">
                            <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                <code>@cause.Code</code>
                                <span>•</span>
                                <span><i class="bi bi-geo-alt-fill text-danger"></i> Pakistan</span>
                            </div>
                            <h5 class="fw-bold mb-2">@cause.Title</h5>
                            <p class="text-muted small flex-grow-1 mb-3">
                                @cause.Description
                            </p>
                            
                            <!-- Balanced Progress Bar & Funding Metrics -->
                            <div class="cause-progress-wrapper mt-auto mb-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span class="text-success">Raised: PKR @cause.RaisedAmount.ToString("N0")</span>
                                    <span class="text-muted">Goal: PKR @cause.TargetAmount.ToString("N0")</span>
                                </div>
                                <div class="progress progress-giveaid">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @percentage%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted fw-semibold">@percentage% Funded</small>
                                </div>
                            </div>

                            <a asp-controller="Donation" asp-action="Donate" asp-route-causeId="@cause.Id" class="btn btn-primary w-100 fw-bold py-2 mt-auto">
                                <i class="bi bi-heart-fill text-danger me-1"></i> Donate to this Cause
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     4. INTERACTIVE LIVE IMPACT CALCULATOR
     ========================================================================== -->
<section class="py-5 impact-calculator-section" style="background: var(--bg-surface-elevated);">
    <div class="container position-relative" style="z-index: 2;">
        <div class="text-center max-w-2xl mx-auto mb-5" data-aos="fade-up">
            <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill mb-2">Real-Time Simulation</span>
            <h2 class="display-6 fw-bold mb-2">See the Direct Impact of Your Donation</h2>
            <p class="text-muted">Drag the slider below to discover what your generosity can accomplish on the ground.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card p-3 p-sm-4 p-md-5 mb-4 tilt-card-3d" data-aos="zoom-in" style="background: var(--bg-surface); border: 1px solid var(--border-glow-primary);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 card-3d-depth-1">
                        <label class="form-label fw-bold fs-5 mb-0">Choose Your Donation Amount:</label>
                        <h2 class="fw-bolder text-warning mb-0" id="calcAmountDisplay">PKR 5,000</h2>
                    </div>

                    <input type="range" class="impact-slider-track mb-4 mb-md-5 card-3d-depth-1" id="impactAmountSlider" min="500" max="50000" step="500" value="5000">

                    <div class="row g-3 g-md-4 text-center card-3d-depth-2">
                        <div class="col-md-4">
                            <div class="impact-result-card h-100 p-3.5 rounded-3 border" style="background: var(--bg-surface-elevated);">
                                <div class="fs-1 mb-2">🍲</div>
                                <h4 class="fw-bold mb-1" id="calcMealsCount">20 Hot Meals</h4>
                                <p class="text-muted small mb-0">Nutritious ration and warm cooked meals provided to needy families.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="impact-result-card h-100 p-3.5 rounded-3 border" style="background: var(--bg-surface-elevated);">
                                <div class="fs-1 mb-2">💧</div>
                                <h4 class="fw-bold mb-1" id="calcWaterDays">50 Days Clean Water</h4>
                                <p class="text-muted small mb-0">Potable clean drinking water filtration and solar pump supply.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="impact-result-card h-100 p-3.5 rounded-3 border" style="background: var(--bg-surface-elevated);">
                                <div class="fs-1 mb-2">🎒</div>
                                <h4 class="fw-bold mb-1" id="calcKitsCount">3 School Kits</h4>
                                <p class="text-muted small mb-0">Uniforms, books, bags, and stationery for underprivileged students.</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4 mt-md-5 card-3d-depth-2">
                        <a href="/Donation/Donate?customAmount=5000" id="calcDonateBtn" class="btn btn-warning btn-lg fw-bold px-4 px-sm-5 text-dark shadow-sm btn-pulse">
                            <i class="bi bi-heart-fill text-danger me-2"></i> Make This Impact Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     5. LATEST WELFARE PROGRAMMES & VOLUNTEER DRIVES
     ========================================================================== -->
<section class="py-5" style="background: var(--bg-surface);">
    <div class="container py-3">
        <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-end gap-3 mb-4" data-aos="fade-up">
            <div>
                <span class="badge bg-info-subtle text-info fw-bold px-3 py-1 rounded-pill mb-2">Field Initiatives</span>
                <h2 class="display-6 fw-bold mb-1">Upcoming Welfare Programmes</h2>
                <p class="text-muted mb-0">Participate as a volunteer, donor, or observer in scheduled field interventions.</p>
            </div>
            <a asp-controller="Programmes" asp-action="Index" class="btn btn-outline-primary fw-bold flex-shrink-0">
                Browse All Programmes <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="card-grid-responsive">
            @foreach (var prog in Model.LatestProgrammes)
            {
                <div class="program-grid-item d-flex" data-aos="fade-up">
                    <div class="card h-100 w-100 card-hover tilt-card-3d border-0 shadow-sm program-card">
                        <div class="position-relative card-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(prog.ImageUrl) ? "https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?w=600&auto=format&fit=crop&q=80" : prog.ImageUrl)" 
                                 class="card-img-top" alt="@prog.Title" loading="lazy">
                            <div class="card-badge-overlay position-absolute top-0 start-0 end-0 d-flex justify-content-between align-items-start p-2.5">
                                <span class="badge bg-dark bg-opacity-75 text-white backdrop-blur">
                                    @prog.Category
                                </span>
                                @if (prog.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark fw-bold shadow-sm">
                                        <i class="bi bi-star-fill text-danger me-1"></i> Featured
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
                                <span><i class="bi bi-geo-alt-fill text-danger"></i> @prog.Location</span>
                                <span class="badge bg-light text-dark border">Cap: @prog.Capacity</span>
                            </div>
                            <h5 class="fw-bold mb-2">@prog.Title</h5>
                            <p class="text-muted small flex-grow-1 mb-3">
                                @prog.Description
                            </p>
                            <div class="p-2 rounded-3 small mb-3 border" style="background: var(--bg-surface-elevated);">
                                <strong><i class="bi bi-calendar-check me-1 text-success"></i> Date:</strong> @prog.StartDate.ToString("dd MMM yyyy") - @prog.EndDate.ToString("dd MMM yyyy")
                            </div>
                            <a asp-controller="Programmes" asp-action="Details" asp-route-id="@prog.Id" class="btn btn-outline-primary w-100 fw-bold mt-auto py-2">
                                View Details & Express Interest
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     6. CERTIFIED PARTNER NGOS SHOWCASE
     ========================================================================== -->
<section class="py-5" style="background: var(--bg-body);">
    <div class="container py-3 text-center">
        <div class="max-w-2xl mx-auto mb-5" data-aos="fade-up">
            <span class="badge bg-secondary-subtle text-secondary fw-bold px-3 py-1 rounded-pill mb-2">Vetted Network</span>
            <h2 class="display-6 fw-bold mb-2">Participating Partner NGOs</h2>
            <p class="text-muted">Give-AID collaborates with verified NGOs across the country to execute audited humanitarian operations.</p>
        </div>

        <div class="card-grid-responsive">
            @foreach (var ngo in Model.FeaturedNgos)
            {
                <div class="d-flex" data-aos="zoom-in">
                    <div class="card h-100 w-100 border-0 shadow-sm p-3.5 text-center card-hover tilt-card-3d ngo-card">
                        <img src="@(string.IsNullOrEmpty(ngo.LogoUrl) ? "https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=200&auto=format&fit=crop&q=80" : ngo.LogoUrl)" 
                             class="rounded-circle mx-auto mb-3 shadow-sm border p-1 card-3d-depth-2" style="width: 72px; height: 72px; object-fit: cover; background: var(--bg-surface-elevated);" alt="@ngo.Name" loading="lazy">
                        <h6 class="fw-bold mb-1 text-primary card-3d-depth-1">@ngo.Name</h6>
                        <small class="text-muted d-block mb-2 card-3d-depth-1">@ngo.City, @ngo.Country (Est. @ngo.EstablishedYear)</small>
                        <p class="small text-muted mb-3 flex-grow-1 card-3d-depth-1">@ngo.Description</p>
                        <a asp-controller="Ngos" asp-action="Details" asp-route-id="@ngo.Id" class="btn btn-sm btn-outline-secondary fw-semibold card-3d-depth-1 mt-auto">View NGO Profile</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     7. FIELD MEDIA GALLERY
     ========================================================================== -->
<section class="py-5" style="background: var(--bg-surface-elevated);">
    <div class="container py-3">
        <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-end gap-3 mb-4" data-aos="fade-up">
            <div>
                <span class="badge bg-warning-subtle text-dark fw-bold px-3 py-1 rounded-pill mb-2">Visual Transparency</span>
                <h2 class="display-6 fw-bold mb-1">Moments of Hope & Care</h2>
                <p class="text-muted mb-0">High-resolution glimpses into our relief expeditions, medical camps, and community projects.</p>
            </div>
            <a asp-controller="Home" asp-action="Gallery" class="btn btn-outline-primary fw-bold flex-shrink-0">
                View Full Photo Gallery <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="card-grid-responsive">
            @foreach (var item in Model.RecentGallery)
            {
                <div data-aos="fade-up">
                    <div class="position-relative rounded-4 shadow-sm card-hover tilt-card-3d gallery-card h-100">
                        <div class="gallery-card-img-wrapper">
                            <img src="@item.ImageUrl" class="card-3d-depth-1" alt="@item.Title" loading="lazy">
                        </div>
                        <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-gradient bg-dark bg-opacity-75 text-white backdrop-blur card-3d-depth-2">
                            <span class="badge bg-warning text-dark mb-1">@item.Category</span>
                            <h6 class="fw-bold mb-0">@item.Title</h6>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     8. CALL TO ACTION BANNER WITH MESH GRADIENT
     ========================================================================== -->
<section class="py-5 text-center position-relative overflow-hidden" style="background: var(--grad-hero); border-top: 1px solid var(--border-color);">
    <div class="hero-mesh-overlay"></div>
    <div class="container py-4 py-md-5 position-relative" style="z-index: 2;" data-aos="zoom-in">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill mb-3">Join the Mission</span>
                <h2 class="display-5 fw-bold mb-3">Be the Catalyst for Human Dignity Today</h2>
                <p class="lead text-secondary mb-4 fs-5">
                    Your contribution directly provides nutritious food rations, emergency medical surgeries, clean water, and classroom education for underprivileged children. Experience the joy of 100% transparent giving.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Donation" asp-action="Donate" class="btn btn-warning btn-lg fw-bold px-4 px-sm-5 text-dark shadow-sm btn-pulse">
                        <i class="bi bi-heart-fill text-danger me-2"></i> Donate Online Now
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4 fw-semibold">
                        <i class="bi bi-person-plus me-2"></i> Create Donor Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script src="~/js/frame-sequence.js" asp-append-version="true"></script>
}
