@model Give_Aid_NGO_Donation_Management_System.Models.ViewModels.HelpCentreViewModel
@{
    ViewData["Title"] = "Help Centre & Support Desk";
}

<!-- Hero Help Section -->
<section class="hero-wrapper py-5">
    <div class="hero-mesh-overlay"></div>
    <div class="container py-3 py-md-4 text-center position-relative" style="z-index:2;">
        <span class="badge bg-success-subtle text-success fw-bold px-3 py-1.5 rounded-pill mb-3">
            <i class="bi bi-question-circle-fill me-1"></i> Give-AID Help Centre
        </span>
        <h1 class="display-5 fw-bold mb-3 text-dark">How Can We Support You Today?</h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-4 fs-6">
            Search our comprehensive knowledge base, review frequently asked questions, or raise a support ticket directly with our donor services team.
        </p>

        <!-- Search Bar -->
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-12">
                <form asp-controller="HelpCentre" asp-action="Index" method="get">
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0 fs-6" placeholder="Search questions (e.g. tax receipt, refund, JazzCash)..." />
                        <button type="submit" class="btn btn-warning fw-bold px-3 px-sm-4 text-dark">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<div class="container py-4 py-md-5">
    <div class="row g-4">
        <!-- FAQ Accordion Column -->
        <div class="col-lg-7">
            <!-- Category Filter Pills -->
            <div class="d-flex gap-2 flex-wrap mb-4">
                <a asp-controller="HelpCentre" asp-action="Index" class="btn btn-sm @(!Model.SelectedCategoryId.HasValue ? "btn-primary" : "btn-outline-secondary")">
                    All Categories
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="HelpCentre" asp-action="Index" asp-route-categoryId="@cat.Id" 
                       class="btn btn-sm @(Model.SelectedCategoryId == cat.Id ? "btn-primary" : "btn-outline-secondary")">
                        @cat.Name
                    </a>
                }
            </div>

            @if (!Model.Faqs.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center text-muted">
                    <i class="bi bi-search fs-1 mb-2"></i>
                    <h5>No answers found for your query.</h5>
                    <p class="small">Try different keywords or submit a query directly using the form on the right.</p>
                </div>
            }
            else
            {
                <div class="accordion" id="faqAccordion">
                    @for (int i = 0; i < Model.Faqs.Count; i++)
                    {
                        var faq = Model.Faqs[i];
                        <div class="accordion-item border-0 shadow-sm rounded-3 mb-3 overflow-hidden">
                            <h2 class="accordion-header" id="heading-@faq.Id">
                                <button class="accordion-button @(i == 0 ? "" : "collapsed") fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@faq.Id" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse-@faq.Id">
                                    <span class="badge bg-light text-primary border me-2 small">@(faq.Category?.Name ?? "General")</span>
                                    @faq.Question
                                </button>
                            </h2>
                            <div id="collapse-@faq.Id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@faq.Id" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary lh-base">
                                    @faq.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Submit Support Ticket Column -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-3 p-sm-4 sticky-lg-top" style="top: 90px;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-danger text-white p-1.5"><i class="bi bi-headset"></i></span>
                    <h5 class="fw-bold mb-0 text-dark">Submit Support Ticket</h5>
                </div>
                <p class="text-muted small mb-4">Can't find what you need? Our team typically responds within 24 hours.</p>

                <form asp-controller="HelpCentre" asp-action="SubmitQuery" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewQuery.Name" class="form-label fw-semibold"></label>
                        <input asp-for="NewQuery.Name" class="form-control" placeholder="Your Full Name" />
                        <span asp-validation-for="NewQuery.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewQuery.Email" class="form-label fw-semibold"></label>
                        <input asp-for="NewQuery.Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="NewQuery.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewQuery.Priority" class="form-label fw-semibold"></label>
                        <select asp-for="NewQuery.Priority" class="form-select">
                            <option value="Low">Low - General Question</option>
                            <option value="Medium" selected>Medium - Feedback / Inquiry</option>
                            <option value="High">High - Donation / Receipt Issue</option>
                            <option value="Urgent">Urgent - Emergency Relief / Partner Dispute</option>
                        </select>
                        <span asp-validation-for="NewQuery.Priority" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewQuery.Subject" class="form-label fw-semibold"></label>
                        <input asp-for="NewQuery.Subject" class="form-control" placeholder="Brief summary of your query" />
                        <span asp-validation-for="NewQuery.Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewQuery.Message" class="form-label fw-semibold"></label>
                        <textarea asp-for="NewQuery.Message" class="form-control" rows="4" placeholder="Provide full details, transaction references, or questions..."></textarea>
                        <span asp-validation-for="NewQuery.Message" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2.5 shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Submit Support Query
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
