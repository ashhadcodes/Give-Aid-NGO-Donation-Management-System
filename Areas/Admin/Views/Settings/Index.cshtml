@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.SiteSetting>
@{
    ViewData["Title"] = "System Site Settings";
    var grouped = Model.GroupBy(s => s.Group).OrderBy(g => g.Key);
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">System Site Settings</h2>
        <p class="text-muted small mb-0">Configure global platform parameters, contact information, social links, and portal rules.</p>
    </div>
</div>

<form asp-area="Admin" asp-controller="Settings" asp-action="UpdateSettings" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        @foreach (var group in grouped)
        {
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-gear-wide-connected me-2"></i> @group.Key Settings
                        </h5>
                    </div>
                    <div class="card-body p-3 p-sm-4">
                        <div class="row g-3">
                            @foreach (var setting in group)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        @setting.SettingKey
                                    </label>
                                    @if (!string.IsNullOrEmpty(setting.Description))
                                    {
                                        <div class="text-muted small mb-1">@setting.Description</div>
                                    }
                                    @if (setting.SettingValue != null && (setting.SettingValue.Length > 80 || setting.SettingKey.Contains("Address") || setting.SettingKey.Contains("Mission")))
                                    {
                                        <textarea name="settings[@setting.SettingKey]" class="form-control" rows="3">@setting.SettingValue</textarea>
                                    }
                                    else
                                    {
                                        <input type="text" name="settings[@setting.SettingKey]" class="form-control" value="@setting.SettingValue" />
                                    }
                                    <small class="text-muted font-monospace d-block">Key: @setting.SettingKey | Last updated: @setting.UpdatedAt.ToString("yyyy-MM-dd")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12 mt-4">
            <div class="card border-0 shadow-sm p-3 p-sm-4 bg-light">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div>
                        <h6 class="fw-bold mb-0">Save Platform Configurations</h6>
                        <small class="text-muted">Changes take effect immediately across all public and admin pages.</small>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg px-4 px-sm-5 fw-bold flex-shrink-0">
                        <i class="bi bi-check2-circle me-1"></i> Save All Settings
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
