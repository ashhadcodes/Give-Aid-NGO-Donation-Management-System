@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.Partner>
@{
    ViewData["Title"] = "Manage Corporate Partners";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Corporate & Strategic Partners</h2>
        <p class="text-muted small mb-0">Manage corporate sponsors, CSR partners, and financial institutions collaborating with Give-AID.</p>
    </div>
    <a asp-area="Admin" asp-controller="Partners" asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
        <i class="bi bi-plus-circle me-1"></i> Add Partner
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted">No partners registered yet. Click "Add Partner" to create one.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var p in Model)
        {
            <div class="admin-mobile-card">
                <div class="d-flex align-items-start gap-3 mb-2">
                    <img src="@(string.IsNullOrEmpty(p.LogoUrl) ? "https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=80&auto=format&fit=crop&q=80" : p.LogoUrl)"
                         class="rounded border admin-thumb admin-thumb-contain" alt="@p.Name" />
                    <div class="min-w-0 flex-grow-1">
                        <div class="fw-bold text-primary">@p.Name</div>
                    </div>
                    @if (p.IsActive)
                    {
                        <span class="badge bg-success flex-shrink-0">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary flex-shrink-0">Inactive</span>
                    }
                </div>
                <div class="admin-mobile-meta mb-3">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Website</span>
                        <span class="admin-mobile-value">
                            @if (!string.IsNullOrEmpty(p.Website))
                            {
                                <a href="@p.Website" target="_blank" rel="noopener">@p.Website</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Email</span>
                        <span class="admin-mobile-value">@(string.IsNullOrEmpty(p.ContactEmail) ? "-" : p.ContactEmail)</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Phone</span>
                        <span class="admin-mobile-value">@(string.IsNullOrEmpty(p.ContactPhone) ? "-" : p.ContactPhone)</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Order</span>
                        <span class="admin-mobile-value">@p.DisplayOrder</span>
                    </div>
                </div>
                <div class="admin-mobile-actions">
                    <a asp-area="Admin" asp-controller="Partners" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <form asp-area="Admin" asp-controller="Partners" asp-action="ToggleStatus" asp-route-id="@p.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                            <i class="bi @(p.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                            @(p.IsActive ? "Pause" : "Activate")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Logo</th>
                        <th>Partner Name</th>
                        <th>Website</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(p.LogoUrl) ? "https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=80&auto=format&fit=crop&q=80" : p.LogoUrl)"
                                     class="rounded border admin-thumb admin-thumb-contain" alt="@p.Name">
                            </td>
                            <td class="fw-bold text-primary">@p.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.Website))
                                {
                                    <a href="@p.Website" target="_blank" rel="noopener" class="small">@p.Website</a>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(p.ContactEmail) ? "-" : p.ContactEmail)</td>
                            <td>@(string.IsNullOrEmpty(p.ContactPhone) ? "-" : p.ContactPhone)</td>
                            <td>@p.DisplayOrder</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a asp-area="Admin" asp-controller="Partners" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-area="Admin" asp-controller="Partners" asp-action="ToggleStatus" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="Toggle Status">
                                            <i class="bi @(p.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
