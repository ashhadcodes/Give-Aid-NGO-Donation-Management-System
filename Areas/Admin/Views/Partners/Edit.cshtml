@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.PartnerFormViewModel
@{
    ViewData["Title"] = "Edit Corporate Partner";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Partners
    </a>
    <h2 class="fw-bold mb-1">Edit Partner: @Model.Name</h2>
    <p class="text-muted small">Update partnership details, branding assets, and contact information.</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <form asp-area="Admin" asp-controller="Partners" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Priority</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label fw-semibold">Website URL</label>
                        <input asp-for="Website" class="form-control" />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactEmail" class="form-label fw-semibold">Contact Email</label>
                        <input asp-for="ContactEmail" class="form-control" />
                        <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactPhone" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="ContactPhone" class="form-control" />
                        <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoUrl" class="form-label fw-semibold">Current Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" />
                        <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <div class="col-12">
                            <label class="form-label fw-semibold">Logo Preview</label>
                            <div>
                                <img src="@Model.LogoUrl" class="rounded border p-1 bg-white" style="height: 60px; object-fit: contain;" alt="Logo" />
                            </div>
                        </div>
                    }

                    <div class="col-md-6 d-flex align-items-center mt-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4"><div class="admin-form-actions"><button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Update Partner
                        </button><a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
