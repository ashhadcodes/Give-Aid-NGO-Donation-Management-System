@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.PartnerFormViewModel
@{
    ViewData["Title"] = "Add Corporate Partner";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Partners
    </a>
    <h2 class="fw-bold mb-1">Add Corporate Partner</h2>
    <p class="text-muted small">Add a sponsoring company or CSR donor organization.</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <form asp-area="Admin" asp-controller="Partners" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Allied Bank CSR Division" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Priority</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label fw-semibold">Website URL</label>
                        <input asp-for="Website" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactEmail" class="form-label fw-semibold">Contact Email</label>
                        <input asp-for="ContactEmail" class="form-control" placeholder="csr@partner.com" />
                        <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactPhone" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="ContactPhone" class="form-control" placeholder="+92-..." />
                        <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief summary of partnership scope and commitments..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoUrl" class="form-label fw-semibold">Or Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center mt-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4"><div class="admin-form-actions"><button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Save Partner
                        </button><a asp-area="Admin" asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
