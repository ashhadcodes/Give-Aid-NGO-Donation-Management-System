@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.GalleryItem>
@{
    ViewData["Title"] = "Media Gallery";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Media & Field Gallery</h2>
        <p class="text-muted small mb-0">Upload and showcase photos of relief drives, school openings, and healthcare camps.</p>
    </div>
    <a asp-area="Admin" asp-controller="Gallery" asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
        <i class="bi bi-cloud-upload me-1"></i> Upload Photo
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 p-sm-5 text-center text-muted">
        <i class="bi bi-images fs-1 mb-2"></i>
        <p class="mb-0">No gallery images uploaded yet. Click "Upload Photo" to add field imagery.</p>
    </div>
}
else
{
    <div class="card-grid-responsive">
        @foreach (var item in Model)
        {
            <div class="d-flex">
                <div class="card border-0 shadow-sm h-100 w-100 overflow-hidden">
                    <div class="position-relative admin-gallery-media">
                        <img src="@item.ImageUrl" alt="@item.Title" />
                        <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2">@item.Category</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="min-w-0">
                            <h6 class="fw-bold mb-1">@item.Title</h6>
                            <p class="text-muted small mb-2">@(string.IsNullOrEmpty(item.Description) ? "No caption" : item.Description)</p>
                            @if (item.Programme != null)
                            {
                                <span class="badge bg-light text-primary border small">
                                    <i class="bi bi-tag-fill me-1"></i> @item.Programme.Title
                                </span>
                            }
                        </div>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top">
                            <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                            <form asp-area="Admin" asp-controller="Gallery" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this image?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
