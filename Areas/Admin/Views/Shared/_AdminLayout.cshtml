<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - Give-AID Administration Console</title>
    
    <!-- Instant Theme Bootstrapper (Zero Flash of Unstyled Theme) -->
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('giveaid_theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
            } catch (e) { }
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body admin-console-body">
    <!-- Admin Frosted Topbar -->
    <header class="admin-topbar navbar navbar-expand navbar-giveaid sticky-top border-bottom">
        <div class="container-fluid px-2 px-sm-3">
            <div class="d-flex align-items-center gap-2 gap-sm-3 min-w-0 flex-grow-1">
                <!-- Mobile / Tablet Sidebar Toggle -->
                <button class="btn btn-outline-secondary admin-sidebar-toggle d-xl-none flex-shrink-0"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#adminMobileOffcanvas"
                        aria-controls="adminMobileOffcanvas"
                        aria-label="Open admin navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0 min-w-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-badge flex-shrink-0"><i class="bi bi-shield-lock-fill"></i> Give-AID</span>
                    <span class="fs-6 fw-semibold text-secondary d-none d-md-inline text-truncate">Admin Console</span>
                </a>

                @if (ViewData["Title"] != null)
                {
                    <span class="admin-page-title text-muted small text-truncate d-none d-xl-inline ms-2 ps-2 border-start">@ViewData["Title"]</span>
                }
            </div>

            <div class="d-flex align-items-center gap-1 gap-sm-2 gap-md-3 flex-shrink-0">
                <!-- Theme Switcher -->
                <div class="dropdown">
                    <button class="theme-selector-btn dropdown-toggle" type="button" id="adminThemeDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Change theme">
                        <i class="bi bi-palette-fill text-warning"></i>
                        <span class="d-none d-lg-inline theme-name-label">Theme</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="adminThemeDropdown" style="min-width: 190px;">
                        <li class="px-3 py-1.5 border-bottom"><small class="fw-bold text-muted text-uppercase">Theme Mode</small></li>
                        <li><button type="button" class="dropdown-item py-2 theme-switch-btn" data-theme="light"><span class="theme-color-dot me-2" style="background:#059669;"></span> Clean Light (Default)</button></li>
                        <li><button type="button" class="dropdown-item py-2 theme-switch-btn" data-theme="emerald"><span class="theme-color-dot me-2" style="background:#10b981;"></span> Cyber Emerald</button></li>
                        <li><button type="button" class="dropdown-item py-2 theme-switch-btn" data-theme="indigo"><span class="theme-color-dot me-2" style="background:#6366f1;"></span> Midnight Indigo</button></li>
                        <li><button type="button" class="dropdown-item py-2 theme-switch-btn" data-theme="gold"><span class="theme-color-dot me-2" style="background:#f59e0b;"></span> Royal Gold</button></li>
                        <li><button type="button" class="dropdown-item py-2 theme-switch-btn" data-theme="ocean"><span class="theme-color-dot me-2" style="background:#06b6d4;"></span> Neon Oceanic</button></li>
                    </ul>
                </div>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex" target="_blank">
                    <i class="bi bi-globe me-1 text-success"></i> Public Site
                </a>

                <div class="dropdown">
                    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center gap-1 gap-sm-2 py-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <span class="admin-user-avatar badge rounded-circle bg-warning text-dark p-1">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <span class="fw-semibold text-truncate d-none d-sm-inline admin-user-name">@(User.Identity?.Name?.Split('@')[0] ?? "Administrator")</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 220px; max-width: min(280px, 92vw);">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark text-truncate">@User.Identity?.Name</div>
                            <small class="text-danger fw-semibold"><i class="bi bi-shield-shaded me-1"></i> Administrator Role</small>
                        </li>
                        <li><a class="dropdown-item py-2" asp-area="" asp-controller="Account" asp-action="Dashboard"><i class="bi bi-grid-1x2-fill me-2 text-primary"></i> User Portal</a></li>
                        <li><a class="dropdown-item py-2" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders me-2 text-secondary"></i> System Settings</a></li>
                        <li><a class="dropdown-item py-2" asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-globe me-2 text-success"></i> Open Public Site</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- Admin Mobile / Tablet Offcanvas Drawer -->
    <div class="offcanvas offcanvas-start admin-offcanvas d-xl-none" tabindex="-1" id="adminMobileOffcanvas" aria-labelledby="adminMobileOffcanvasLabel" data-bs-scroll="false">
        <div class="offcanvas-header border-bottom px-3 px-sm-4 py-3">
            <div class="d-flex align-items-center gap-2 min-w-0" id="adminMobileOffcanvasLabel">
                <span class="badge bg-success text-white px-2 py-1 rounded flex-shrink-0"><i class="bi bi-shield-lock-fill"></i> Give-AID</span>
                <span class="fw-bold text-dark fs-6 text-truncate">Admin Menu</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column">
            <nav class="admin-offcanvas-nav flex-grow-1" aria-label="Admin mobile navigation">
                <div class="sidebar-heading text-muted fw-bold small text-uppercase mb-2">Analytics & Overview</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 text-primary"></i> <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-graph-up-arrow text-success"></i> <span>Financial Reports</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading text-muted fw-bold small text-uppercase mb-2">Donations & Causes</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index">
                            <i class="bi bi-cash-stack text-warning"></i> <span>All Donations</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index" asp-route-status="Pending">
                            <i class="bi bi-shield-check text-warning"></i> <span>Verify Payments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Causes" asp-action="Index">
                            <i class="bi bi-heart-pulse text-danger"></i> <span>Donation Causes</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading text-muted fw-bold small text-uppercase mb-2">Network & Programmes</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Ngos" asp-action="Index">
                            <i class="bi bi-buildings text-info"></i> <span>Partner NGOs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Partners" asp-action="Index">
                            <i class="bi bi-handshake text-secondary"></i> <span>Corporate Partners</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Programmes" asp-action="Index">
                            <i class="bi bi-calendar-check text-success"></i> <span>Programmes & Drives</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Gallery" asp-action="Index">
                            <i class="bi bi-images text-warning"></i> <span>Media Gallery</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading text-muted fw-bold small text-uppercase mb-2">CMS & Support</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="AboutPages" asp-action="Index">
                            <i class="bi bi-file-earmark-richtext text-primary"></i> <span>About Us CMS</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Faqs" asp-action="Index">
                            <i class="bi bi-question-diamond text-info"></i> <span>FAQs & Help Centre</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Queries" asp-action="Index">
                            <i class="bi bi-headset text-danger"></i> <span>Support Queries</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                            <i class="bi bi-envelope-open text-warning"></i> <span>Contact Messages</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Invitations" asp-action="Index">
                            <i class="bi bi-person-plus text-success"></i> <span>Invitation Logs</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading text-muted fw-bold small text-uppercase mb-2">Security & System</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people text-info"></i> <span>Users & Roles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-shield-check text-success"></i> <span>Audit Logs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-sliders text-secondary"></i> <span>Site Settings</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="admin-offcanvas-footer border-top pt-3 mt-auto">
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="admin-shell d-flex w-100">
        <!-- Admin Desktop Sidebar (xl+ / >=1200px only — below that use offcanvas) -->
        <aside class="admin-sidebar shadow-sm d-none d-xl-flex flex-column" aria-label="Admin desktop navigation">
            <div class="admin-sidebar-inner py-3">
                <div class="sidebar-heading">Analytics & Overview</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-graph-up-arrow"></i> <span>Financial Reports</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading">Donations & Causes</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index">
                            <i class="bi bi-cash-stack"></i> <span>All Donations</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index" asp-route-status="Pending">
                            <i class="bi bi-shield-check text-warning"></i> <span>Verify Payments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Causes" asp-action="Index">
                            <i class="bi bi-heart-pulse"></i> <span>Donation Causes</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading">Network & Programmes</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Ngos" asp-action="Index">
                            <i class="bi bi-buildings"></i> <span>Partner NGOs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Partners" asp-action="Index">
                            <i class="bi bi-handshake"></i> <span>Corporate Partners</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Programmes" asp-action="Index">
                            <i class="bi bi-calendar-check"></i> <span>Programmes & Drives</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Gallery" asp-action="Index">
                            <i class="bi bi-images"></i> <span>Media Gallery</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading">CMS & Support</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="AboutPages" asp-action="Index">
                            <i class="bi bi-file-earmark-richtext"></i> <span>About Us CMS</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Faqs" asp-action="Index">
                            <i class="bi bi-question-diamond"></i> <span>FAQs & Help Centre</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Queries" asp-action="Index">
                            <i class="bi bi-headset"></i> <span>Support Queries</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                            <i class="bi bi-envelope-open"></i> <span>Contact Messages</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Invitations" asp-action="Index">
                            <i class="bi bi-person-plus"></i> <span>Invitation Logs</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading">Security & System</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people"></i> <span>Users & Roles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-shield-check"></i> <span>Audit Logs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-sliders"></i> <span>Site Settings</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Admin Main Content -->
        <main class="admin-main flex-grow-1">
            <div class="container-fluid admin-main-inner">
                <partial name="_NotificationPartial" />
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Master JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
