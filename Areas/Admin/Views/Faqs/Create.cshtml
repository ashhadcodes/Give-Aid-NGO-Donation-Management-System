@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.FaqFormViewModel
@{
    ViewData["Title"] = "Add New FAQ";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Faqs" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to FAQs
    </a>
    <h2 class="fw-bold mb-1">Add New FAQ</h2>
    <p class="text-muted small">Add a clear question and informative response to the Help Centre.</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <form asp-area="Admin" asp-controller="Faqs" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="FaqCategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="FaqCategoryId" class="form-select">
                            <option value="">-- Select Category --</option>
                            @if (Model.AvailableCategories != null)
                            {
                                @foreach (var cat in Model.AvailableCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="FaqCategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Question" class="form-label fw-semibold"></label>
                        <input asp-for="Question" class="form-control" placeholder="e.g. How can I verify that my donation reached the cause?" />
                        <span asp-validation-for="Question" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Answer" class="form-label fw-semibold"></label>
                        <textarea asp-for="Answer" class="form-control" rows="6" placeholder="Provide a detailed and transparent answer..."></textarea>
                        <span asp-validation-for="Answer" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center mt-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4"><div class="admin-form-actions"><button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Save FAQ
                        </button><a asp-area="Admin" asp-controller="Faqs" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
