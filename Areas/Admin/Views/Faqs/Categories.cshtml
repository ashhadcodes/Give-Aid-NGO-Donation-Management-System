@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.FaqCategory>
@{
    ViewData["Title"] = "FAQ Categories";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Faqs" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to FAQs
    </a>
    <h2 class="fw-bold mb-1">FAQ Categories</h2>
    <p class="text-muted small">Organize FAQs into logical groups for the public Help Centre.</p>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center text-muted">No categories created yet.</div>
        }
        else
        {
            <div class="d-md-none d-flex flex-column gap-3 mb-3">
                @foreach (var cat in Model)
                {
                    <div class="admin-mobile-card">
                        <div class="fw-bold text-primary mb-2">@cat.Name</div>
                        <div class="admin-mobile-meta">
                            <div class="admin-mobile-row">
                                <span class="admin-mobile-label">Description</span>
                                <span class="admin-mobile-value">@(string.IsNullOrEmpty(cat.Description) ? "-" : cat.Description)</span>
                            </div>
                            <div class="admin-mobile-row">
                                <span class="admin-mobile-label">FAQs</span>
                                <span class="admin-mobile-value"><span class="badge bg-secondary">@(cat.Faqs?.Count ?? 0)</span></span>
                            </div>
                            <div class="admin-mobile-row">
                                <span class="admin-mobile-label">Order</span>
                                <span class="admin-mobile-value">@cat.DisplayOrder</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
                <div class="table-responsive admin-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>FAQs Count</th>
                                <th>Order</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@cat.Name</td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(cat.Description) ? "-" : cat.Description)</td>
                                    <td><span class="badge bg-secondary">@(cat.Faqs?.Count ?? 0) FAQs</span></td>
                                    <td>@cat.DisplayOrder</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-folder-plus me-2"></i> Add New Category</h5>
            <form asp-area="Admin" asp-controller="Faqs" asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Donations & Receipts" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <input type="text" name="description" class="form-control" placeholder="Brief summary of topics covered" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Display Order</label>
                    <input type="number" name="displayOrder" class="form-control" value="0" />
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-check-circle me-1"></i> Create Category
                </button>
            </form>
        </div>
    </div>
</div>
