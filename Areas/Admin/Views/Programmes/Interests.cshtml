@model Give_Aid_NGO_Donation_Management_System.Models.Entities.Programme
@{
    ViewData["Title"] = $"Interested Volunteers / Donors - {Model.Title}";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Programmes" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Programmes
    </a>
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 admin-page-header">
        <div class="min-w-0">
            <h2 class="fw-bold mb-1">Interested Participants & Volunteers</h2>
            <p class="text-muted small mb-0">Programme: <strong>@Model.Title</strong> (@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd, yyyy"))</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 flex-shrink-0">@(Model.Interests?.Count ?? 0) Expressions of Interest</span>
    </div>
</div>

@if (Model.Interests == null || !Model.Interests.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted">No users have signed up or expressed interest in this programme yet.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var item in Model.Interests)
        {
            <div class="admin-mobile-card">
                <div class="fw-semibold mb-2">@(item.User?.FullName ?? "Registered User")</div>
                <div class="admin-mobile-meta">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Email</span>
                        <span class="admin-mobile-value"><a href="mailto:@item.User?.Email">@item.User?.Email</a></span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Phone</span>
                        <span class="admin-mobile-value">@(string.IsNullOrEmpty(item.User?.PhoneNumber) ? "Not provided" : item.User.PhoneNumber)</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Expressed</span>
                        <span class="admin-mobile-value text-muted small">@item.ExpressedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Notes</span>
                        <span class="admin-mobile-value">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Donor / User</th>
                        <th>Email Address</th>
                        <th>Phone</th>
                        <th>Interest Expressed At</th>
                        <th>Notes / Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Interests)
                    {
                        <tr>
                            <td class="fw-semibold">@(item.User?.FullName ?? "Registered User")</td>
                            <td><a href="mailto:@item.User?.Email">@item.User?.Email</a></td>
                            <td>@(string.IsNullOrEmpty(item.User?.PhoneNumber) ? "Not provided" : item.User.PhoneNumber)</td>
                            <td class="text-muted small">@item.ExpressedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
