@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.Programme>
@{
    ViewData["Title"] = "Manage Welfare Programmes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Welfare Programmes & Activities</h2>
        <p class="text-muted small mb-0">Create scheduled relief initiatives, medical drives, and track volunteer/donor interest signups.</p>
    </div>
    <a asp-area="Admin" asp-controller="Programmes" asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0">
        <i class="bi bi-plus-circle me-1"></i> Add Programme
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted">No welfare programmes found. Click "Add Programme" to create one.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var p in Model)
        {
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="min-w-0">
                        <div class="fw-bold text-primary">@p.Title</div>
                        <span class="badge bg-light text-dark border">@p.Category</span>
                    </div>
                    @switch (p.Status)
                    {
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Upcoming:
                            <span class="badge bg-info text-dark flex-shrink-0">Upcoming</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Ongoing:
                            <span class="badge bg-success flex-shrink-0">Ongoing</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Completed:
                            <span class="badge bg-secondary flex-shrink-0">Completed</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Cancelled:
                            <span class="badge bg-danger flex-shrink-0">Cancelled</span>
                            break;
                    }
                </div>
                <div class="admin-mobile-meta mb-3">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">NGO</span>
                        <span class="admin-mobile-value">@(p.NGO?.Name ?? "Give-AID Central")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Dates</span>
                        <span class="admin-mobile-value">@p.StartDate.ToString("MMM dd, yyyy") – @p.EndDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Location</span>
                        <span class="admin-mobile-value">@p.Location</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Interests</span>
                        <span class="admin-mobile-value">@(p.Interests?.Count ?? 0) expressed</span>
                    </div>
                </div>
                <div class="admin-mobile-actions">
                    <a asp-area="Admin" asp-controller="Programmes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-area="Admin" asp-controller="Programmes" asp-action="Interests" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-person-lines-fill me-1"></i> Interests
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Programme</th>
                        <th>Partner NGO</th>
                        <th>Dates</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Interests</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-primary">@p.Title</div>
                                <span class="badge bg-light text-dark border">@p.Category</span>
                            </td>
                            <td>
                                <div class="small fw-semibold">@(p.NGO?.Name ?? "Give-AID Central")</div>
                            </td>
                            <td class="small">
                                <div>@p.StartDate.ToString("MMM dd, yyyy")</div>
                                <small class="text-muted">to @p.EndDate.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="small">@p.Location</td>
                            <td>
                                @switch (p.Status)
                                {
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Upcoming:
                                        <span class="badge bg-info text-dark">Upcoming</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Ongoing:
                                        <span class="badge bg-success">Ongoing</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Completed:
                                        <span class="badge bg-secondary">Completed</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeStatus.Cancelled:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="Programmes" asp-action="Interests" asp-route-id="@p.Id" class="badge bg-primary text-decoration-none">
                                    <i class="bi bi-people-fill me-1"></i> @(p.Interests?.Count ?? 0) Expressed
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a asp-area="Admin" asp-controller="Programmes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit Programme">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="Programmes" asp-action="Interests" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info" title="View Interested Users">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
