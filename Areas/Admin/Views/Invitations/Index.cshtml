@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.Invitation>
@{
    ViewData["Title"] = "Friend Invitations Log";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Friend Invitations Log</h2>
        <p class="text-muted small mb-0">Track referral and invite emails sent by registered donors to expand the community.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted">No invitations sent yet.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var inv in Model)
        {
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="min-w-0">
                        <div class="fw-semibold">@inv.FriendName</div>
                        <code class="small">@inv.FriendEmail</code>
                    </div>
                    @switch (inv.Status)
                    {
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.InvitationStatus.Accepted:
                            <span class="badge bg-success flex-shrink-0"><i class="bi bi-check-circle me-1"></i> Joined</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.InvitationStatus.Expired:
                            <span class="badge bg-secondary flex-shrink-0">Expired</span>
                            break;
                        default:
                            <span class="badge bg-warning text-dark flex-shrink-0"><i class="bi bi-clock me-1"></i> Sent</span>
                            break;
                    }
                </div>
                <div class="admin-mobile-meta">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Invited By</span>
                        <span class="admin-mobile-value">
                            <div>@(inv.SenderUser?.FullName ?? inv.SenderName)</div>
                            <small class="text-muted">@(inv.SenderUser?.Email ?? inv.SenderEmail)</small>
                        </span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Note</span>
                        <span class="admin-mobile-value">@(string.IsNullOrEmpty(inv.Message) ? "Default invite note" : inv.Message)</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Sent</span>
                        <span class="admin-mobile-value text-muted small">@inv.SentAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Token</span>
                        <span class="admin-mobile-value"><span class="badge bg-light text-dark font-monospace border">@inv.InvitationToken</span></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Invited By</th>
                        <th>Invitee (Friend)</th>
                        <th>Personal Note</th>
                        <th>Status</th>
                        <th>Date Sent</th>
                        <th>Invite Token</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@(inv.SenderUser?.FullName ?? inv.SenderName)</div>
                                <small class="text-muted">@(inv.SenderUser?.Email ?? inv.SenderEmail)</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@inv.FriendName</div>
                                <code>@inv.FriendEmail</code>
                            </td>
                            <td>
                                <div class="text-muted small">
                                    @(string.IsNullOrEmpty(inv.Message) ? "Default invite note" : inv.Message)
                                </div>
                            </td>
                            <td>
                                @switch (inv.Status)
                                {
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.InvitationStatus.Accepted:
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Joined</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.InvitationStatus.Expired:
                                        <span class="badge bg-secondary">Expired</span>
                                        break;
                                    default:
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Sent</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">@inv.SentAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><span class="badge bg-light text-dark font-monospace border">@inv.InvitationToken</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
