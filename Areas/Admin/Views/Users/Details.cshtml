@model Give_Aid_NGO_Donation_Management_System.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = $"User Details: {Model.FullName}";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var donations = ViewBag.Donations as IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.Donation> ?? Enumerable.Empty<Give_Aid_NGO_Donation_Management_System.Models.Entities.Donation>();
    var interests = ViewBag.Interests as IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeInterest> ?? Enumerable.Empty<Give_Aid_NGO_Donation_Management_System.Models.Entities.ProgrammeInterest>();
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Users
    </a>
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 admin-page-header">
        <div class="min-w-0">
            <h2 class="fw-bold mb-1 text-break">@Model.FullName</h2>
            <p class="text-muted small mb-0">Registered user since @Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole("SuperAdmin"))
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="EditRoles" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-shield-lock me-1"></i> Manage Roles
                </a>
            }
            <form asp-area="Admin" asp-controller="Users" asp-action="ToggleActive" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    @(Model.IsActive ? "Deactivate Account" : "Activate Account")
                </button>
            </form>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- User Profile Overview -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-person-badge me-2"></i> Account Profile</h5>
            
            <div class="mb-2"><strong class="small text-muted d-block">Full Name</strong> @Model.FullName</div>
            <div class="mb-2"><strong class="small text-muted d-block">Email Address</strong> <a href="mailto:@Model.Email">@Model.Email</a></div>
            <div class="mb-2"><strong class="small text-muted d-block">Phone Number</strong> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</div>
            <div class="mb-2"><strong class="small text-muted d-block">Profession</strong> @(string.IsNullOrEmpty(Model.Profession) ? "Not provided" : Model.Profession)</div>
            <div class="mb-2"><strong class="small text-muted d-block">Location</strong> @(string.IsNullOrEmpty(Model.City) ? "-" : $"{Model.City}, {Model.Country}")</div>
            <div class="mb-2"><strong class="small text-muted d-block">Address</strong> @(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</div>
            
            <hr />
            
            <div class="mb-2">
                <strong class="small text-muted d-block mb-1">Assigned Security Roles</strong>
                @foreach (var r in roles)
                {
                    <span class="badge @(r == "SuperAdmin" ? "bg-danger" : "bg-primary") me-1">@r</span>
                }
            </div>

            <div class="mt-3">
                <strong class="small text-muted d-block mb-1">Account Status</strong>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Deactivated</span>
                }
            </div>
        </div>
    </div>

    <!-- User Donations and Programme Interests -->
    <div class="col-12 col-lg-8">
        <!-- Donation History -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <h5 class="fw-bold mb-0 text-success"><i class="bi bi-cash-stack me-2"></i> User Donation History</h5>
                <span class="badge bg-light text-dark border">@donations.Count() Records</span>
            </div>
            @if (!donations.Any())
            {
                <div class="p-4 text-center text-muted">No donations recorded for this user.</div>
            }
            else
            {
                <div class="d-md-none d-flex flex-column gap-3 p-3">
                    @foreach (var d in donations)
                    {
                        <div class="admin-mobile-card">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <code>@(d.Receipt?.ReceiptNumber ?? $"#{d.Id}")</code>
                                <span class="badge @(d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid ? "bg-success" : "bg-warning text-dark") flex-shrink-0">@d.Status</span>
                            </div>
                            <div class="admin-mobile-meta mb-3">
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Cause</span>
                                    <span class="admin-mobile-value">@(d.Cause?.Title ?? "General Cause")</span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Amount</span>
                                    <span class="admin-mobile-value fw-bold text-success">@d.Currency @d.Amount.ToString("N0")</span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Date</span>
                                    <span class="admin-mobile-value text-muted">@d.CreatedAt.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                            <div class="d-grid">
                                <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="table-responsive admin-table-wrap d-none d-md-block">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Receipt</th>
                                <th>Cause</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in donations)
                            {
                                <tr>
                                    <td><code>@(d.Receipt?.ReceiptNumber ?? $"#{d.Id}")</code></td>
                                    <td>@(d.Cause?.Title ?? "General Cause")</td>
                                    <td class="fw-bold text-success">@d.Currency @d.Amount.ToString("N0")</td>
                                    <td>
                                        <span class="badge @(d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid ? "bg-success" : "bg-warning text-dark")">
                                            @d.Status
                                        </span>
                                    </td>
                                    <td class="text-muted">@d.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">
                                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Expressed Programme Interests -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-calendar-heart me-2"></i> Programme Interests / Volunteer Drives</h5>
            </div>
            @if (!interests.Any())
            {
                <div class="p-4 text-center text-muted">No programme interests expressed yet.</div>
            }
            else
            {
                <div class="d-md-none d-flex flex-column gap-3 p-3">
                    @foreach (var pi in interests)
                    {
                        <div class="admin-mobile-card">
                            <div class="fw-semibold mb-2">@(pi.Programme?.Title ?? "Activity")</div>
                            <div class="admin-mobile-meta">
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Expressed</span>
                                    <span class="admin-mobile-value text-muted">@pi.ExpressedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Notes</span>
                                    <span class="admin-mobile-value">@(string.IsNullOrEmpty(pi.Notes) ? "-" : pi.Notes)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="table-responsive admin-table-wrap d-none d-md-block">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Programme</th>
                                <th>Expressed At</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pi in interests)
                            {
                                <tr>
                                    <td class="fw-semibold">@(pi.Programme?.Title ?? "Activity")</td>
                                    <td class="text-muted">@pi.ExpressedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(string.IsNullOrEmpty(pi.Notes) ? "-" : pi.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
