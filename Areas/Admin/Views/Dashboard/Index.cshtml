@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Admin Dashboard";
}

<!-- Dashboard Header Actions Bar -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Executive Dashboard & Operations</h2>
        <p class="text-muted small mb-0">Real-time overview of incoming donations, volunteer programmes, and system audit state.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="btn btn-primary btn-sm">
            <i class="bi bi-cash-stack me-1"></i> View All Donations
        </a>
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-graph-up-arrow me-1"></i> Financial Reports
        </a>
    </div>
</div>

<!-- Primary Metric Cards: Desktop 4 / Tablet 2 / Mobile 1 -->
<div class="admin-stat-grid mb-3">
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-success-subtle text-success fw-bold">Total Donations</span>
            <i class="bi bi-wallet2 text-success fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-success">PKR @Model.TotalDonationAmount.ToString("N0")</h3>
        <small class="text-muted">@Model.TotalDonationCount total contribution records</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-warning-subtle text-warning fw-bold">Pending</span>
            <i class="bi bi-hourglass-split text-warning fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-warning">@Model.PendingDonationsCount</h3>
        <small class="text-muted">Awaiting verification / processing</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-primary-subtle text-primary fw-bold">Approved</span>
            <i class="bi bi-check2-circle text-primary fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-primary">@Model.ApprovedDonationsCount</h3>
        <small class="text-muted">Successfully verified payments</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-info-subtle text-info fw-bold">Users</span>
            <i class="bi bi-people text-info fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-info">@Model.TotalDonorsCount</h3>
        <small class="text-muted">Registered accounts & donors</small>
    </div>
</div>

<div class="admin-stat-grid mb-4">
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-secondary-subtle text-secondary fw-bold">Programmes</span>
            <i class="bi bi-calendar-event text-secondary fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1">@Model.ActiveProgrammesCount</h3>
        <small class="text-muted">@Model.ActiveCausesCount active causes</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-success-subtle text-success fw-bold">NGOs</span>
            <i class="bi bi-buildings text-success fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-success">@Model.TotalPartnerNgos</h3>
        <small class="text-muted">Certified partner NGOs</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-primary-subtle text-primary fw-bold">Partners</span>
            <i class="bi bi-handshake text-primary fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-primary">@Model.TotalPartnersCount</h3>
        <small class="text-muted">Corporate / institutional partners</small>
    </div>
    <div class="card border-0 shadow-sm p-3 h-100 admin-stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="badge bg-danger-subtle text-danger fw-bold">Queries</span>
            <i class="bi bi-headset text-danger fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1 text-danger">@Model.OpenQueriesCount</h3>
        <small class="text-muted">@Model.UnreadMessagesCount unread contact messages</small>
    </div>
</div>

<!-- Interactive Analytics Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-3 p-sm-4 h-100">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line me-2 text-primary"></i> Monthly Donation Trends (PKR)</h5>
                <span class="badge bg-light text-dark border">Last 6 Months</span>
            </div>
            <div class="admin-chart-box">
                <canvas id="monthlyDonationsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm p-3 p-sm-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart me-2 text-success"></i> Fund Distribution</h5>
                <span class="badge bg-light text-dark border">By Cause</span>
            </div>
            <div class="admin-chart-box">
                <canvas id="causesDonutChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions & Audit Trail Row -->
<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i> Recent Incoming Donations</h5>
                <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            @if (!Model.RecentDonations.Any())
            {
                <div class="p-4 text-center text-muted">No donations found.</div>
            }
            else
            {
                <div class="d-md-none d-flex flex-column gap-3 p-3">
                    @foreach (var d in Model.RecentDonations)
                    {
                        <div class="admin-mobile-card">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="min-w-0">
                                    <div class="fw-semibold">@(d.IsAnonymous ? "Anonymous Donor" : d.DonorName)</div>
                                    <small class="text-muted">@d.DonorEmail</small>
                                </div>
                                @if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid)
                                {
                                    <span class="badge bg-success flex-shrink-0">Paid</span>
                                }
                                else if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded)
                                {
                                    <span class="badge bg-danger flex-shrink-0">Refunded</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark flex-shrink-0">@d.Status</span>
                                }
                            </div>
                            <div class="admin-mobile-meta mb-3">
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Receipt</span>
                                    <span class="admin-mobile-value"><code>@(d.Receipt?.ReceiptNumber ?? $"#{d.Id}")</code></span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Cause</span>
                                    <span class="admin-mobile-value">@(d.Cause?.Title ?? "General Relief")</span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Amount</span>
                                    <span class="admin-mobile-value fw-bold text-success">@d.Currency @d.Amount.ToString("N0")</span>
                                </div>
                                <div class="admin-mobile-row">
                                    <span class="admin-mobile-label">Gateway</span>
                                    <span class="admin-mobile-value"><span class="badge bg-light text-dark border">@d.PaymentMethod</span></span>
                                </div>
                            </div>
                            <div class="d-grid">
                                <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="table-responsive admin-table-wrap d-none d-md-block">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Receipt / ID</th>
                                <th>Donor</th>
                                <th>Cause</th>
                                <th>Amount</th>
                                <th>Gateway</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.RecentDonations)
                            {
                                <tr>
                                    <td><code>@(d.Receipt?.ReceiptNumber ?? $"#{d.Id}")</code></td>
                                    <td>
                                        <div class="fw-semibold">@(d.IsAnonymous ? "Anonymous Donor" : d.DonorName)</div>
                                        <small class="text-muted">@d.DonorEmail</small>
                                    </td>
                                    <td>@(d.Cause?.Title ?? "General Relief")</td>
                                    <td class="fw-bold text-success">@d.Currency @d.Amount.ToString("N0")</td>
                                    <td><span class="badge bg-light text-dark border">@d.PaymentMethod</span></td>
                                    <td>
                                        @if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded)
                                        {
                                            <span class="badge bg-danger">Refunded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@d.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check me-2 text-success"></i> Recent Activity Logs</h5>
                <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-outline-secondary">All Logs</a>
            </div>
            <div class="p-3">
                <div class="d-flex flex-column gap-3">
                    @if (!Model.RecentAuditLogs.Any())
                    {
                        <p class="text-muted small text-center my-3">No activity logs recorded yet.</p>
                    }
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <div class="border-bottom pb-2">
                            <div class="d-flex justify-content-between align-items-start mb-1 gap-2">
                                <span class="badge bg-light text-dark border small">@log.Action</span>
                                <small class="text-muted flex-shrink-0">@log.Timestamp.ToString("HH:mm")</small>
                            </div>
                            <small class="text-dark d-block fw-semibold">@log.Details</small>
                            <small class="text-muted">By: @log.UserEmail</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyDonations.Keys));
            const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyDonations.Values));
            const causeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CausesDistribution.Keys));
            const causeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CausesDistribution.Values));

            const monthlyCtx = document.getElementById('monthlyDonationsChart');
            if (monthlyCtx) {
                new Chart(monthlyCtx, {
                    type: 'bar',
                    data: {
                        labels: monthlyLabels,
                        datasets: [{
                            label: 'Donations Raised (PKR)',
                            data: monthlyData,
                            backgroundColor: 'rgba(13, 148, 136, 0.75)',
                            borderColor: '#0d9488',
                            borderWidth: 2,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return 'PKR ' + Number(ctx.raw).toLocaleString();
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0,0,0,0.05)' },
                                ticks: {
                                    callback: function(val) { return 'PKR ' + Number(val).toLocaleString(); }
                                }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            const causesCtx = document.getElementById('causesDonutChart');
            if (causesCtx) {
                new Chart(causesCtx, {
                    type: 'doughnut',
                    data: {
                        labels: causeLabels,
                        datasets: [{
                            data: causeData,
                            backgroundColor: ['#0d9488', '#3b82f6', '#f59e0b', '#ef4444', '#10b981', '#06b6d4', '#ec4899'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, padding: 10, font: { size: 11 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
