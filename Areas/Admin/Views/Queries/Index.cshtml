@model IEnumerable<Give_Aid_NGO_Donation_Management_System.Models.Entities.SupportQuery>
@{
    ViewData["Title"] = "Donor Support Queries";
    var selectedStatus = ViewBag.SelectedStatus as Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus?;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Donor Support Tickets & Queries</h2>
        <p class="text-muted small mb-0">Help desk and ticket tracking for donor inquiries, payment questions, and receipt requests.</p>
    </div>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-area="Admin" asp-controller="Queries" asp-action="Index" class="btn btn-sm @(!selectedStatus.HasValue ? "btn-primary" : "btn-outline-secondary")">
        All Tickets
    </a>
    <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Open"
       class="btn btn-sm @(selectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Open ? "btn-primary" : "btn-outline-secondary")">
        Open
    </a>
    <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress"
       class="btn btn-sm @(selectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress ? "btn-primary" : "btn-outline-secondary")">
        In Progress
    </a>
    <a asp-area="Admin" asp-controller="Queries" asp-action="Index" asp-route-status="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved"
       class="btn btn-sm @(selectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved ? "btn-primary" : "btn-outline-secondary")">
        Resolved
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted">No support queries found for this status.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var q in Model)
        {
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="min-w-0">
                        <code>#@q.Id</code>
                        <div class="fw-semibold mt-1">@q.Subject</div>
                    </div>
                    @switch (q.Status)
                    {
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Open:
                            <span class="badge bg-danger flex-shrink-0">Open</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress:
                            <span class="badge bg-warning text-dark flex-shrink-0">In Progress</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved:
                            <span class="badge bg-success flex-shrink-0">Resolved</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Closed:
                            <span class="badge bg-secondary flex-shrink-0">Closed</span>
                            break;
                    }
                </div>
                <p class="text-muted small mb-3">@q.Message</p>
                <div class="admin-mobile-meta mb-3">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Sender</span>
                        <span class="admin-mobile-value">
                            <div>@q.Name</div>
                            <small class="text-muted">@q.Email</small>
                        </span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Priority</span>
                        <span class="admin-mobile-value">
                            @switch (q.Priority)
                            {
                                case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.Urgent:
                                    <span class="badge bg-danger">Urgent</span>
                                    break;
                                case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.High:
                                    <span class="badge bg-warning text-dark">High</span>
                                    break;
                                case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.Medium:
                                    <span class="badge bg-info text-dark">Medium</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark border">Low</span>
                                    break;
                            }
                        </span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Created</span>
                        <span class="admin-mobile-value text-muted small">@q.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="d-grid">
                    <a asp-area="Admin" asp-controller="Queries" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-chat-square-text me-1"></i> View & Reply
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket #</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Sender</th>
                        <th>Subject</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td><code>#@q.Id</code></td>
                            <td>
                                @switch (q.Priority)
                                {
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.Urgent:
                                        <span class="badge bg-danger">Urgent</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.High:
                                        <span class="badge bg-warning text-dark">High</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryPriority.Medium:
                                        <span class="badge bg-info text-dark">Medium</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">Low</span>
                                        break;
                                }
                            </td>
                            <td>
                                @switch (q.Status)
                                {
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Open:
                                        <span class="badge bg-danger">Open</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress:
                                        <span class="badge bg-warning text-dark">In Progress</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved:
                                        <span class="badge bg-success">Resolved</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Closed:
                                        <span class="badge bg-secondary">Closed</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@q.Name</div>
                                <small class="text-muted">@q.Email</small>
                            </td>
                            <td>
                                <div>@q.Subject</div>
                                <small class="text-muted">@q.Message</small>
                            </td>
                            <td class="text-muted small">@q.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Queries" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-chat-square-text me-1"></i> View & Reply
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
