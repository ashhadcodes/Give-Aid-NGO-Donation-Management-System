@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.QueryReplyViewModel
@{
    ViewData["Title"] = $"Query #{Model.QueryId} - {Model.Subject}";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Queries" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Support Tickets
    </a>
    <h2 class="fw-bold mb-1">Support Ticket #@Model.QueryId</h2>
    <p class="text-muted small">Submitted on @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm p-3 p-sm-4 mb-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-2 mb-3">
                <h5 class="fw-bold text-primary mb-0 min-w-0">@Model.Subject</h5>
                <span class="badge @(Model.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved ? "bg-success" : "bg-warning text-dark") flex-shrink-0">
                    @Model.Status
                </span>
            </div>

            <div class="bg-light p-3 rounded mb-3">
                <div class="row g-2 small">
                    <div class="col-sm-6"><strong>User / Donor:</strong> @Model.SenderName</div>
                    <div class="col-sm-6"><strong>Email:</strong> <a href="mailto:@Model.SenderEmail">@Model.SenderEmail</a></div>
                    <div class="col-sm-6"><strong>Priority:</strong> @Model.Priority</div>
                    <div class="col-sm-6"><strong>Status:</strong> @Model.Status</div>
                </div>
            </div>

            <h6 class="fw-bold text-muted small text-uppercase">Donor Message</h6>
            <div class="p-3 border rounded bg-white" style="white-space: pre-wrap; min-height: 120px;">@Model.Message</div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-reply-all-fill me-2 text-primary"></i> Respond to Query</h5>
            <p class="text-muted small mb-3">Write an official resolution. You can automatically send an email update to the user.</p>

            <form asp-area="Admin" asp-controller="Queries" asp-action="Reply" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="QueryId" />
                <input type="hidden" asp-for="SenderName" />
                <input type="hidden" asp-for="SenderEmail" />
                <input type="hidden" asp-for="Subject" />
                <input type="hidden" asp-for="Message" />
                <input type="hidden" asp-for="Priority" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-semibold">Update Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Resolved">Mark as Resolved</option>
                        <option value="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.InProgress">In Progress</option>
                        <option value="@Give_Aid_NGO_Donation_Management_System.Models.Entities.QueryStatus.Closed">Close Ticket</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="AdminResponse" class="form-label fw-semibold">Official Resolution Response</label>
                    <textarea asp-for="AdminResponse" class="form-control" rows="8" placeholder="Type your response to the user here..." required></textarea>
                    <span asp-validation-for="AdminResponse" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="SendEmailNotification" class="form-check-input" type="checkbox" />
                    <label asp-for="SendEmailNotification" class="form-check-label fw-semibold">Send email notification to user</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-send-fill me-1"></i> Submit Response & Update
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
