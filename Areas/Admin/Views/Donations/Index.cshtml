@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.DonationListViewModel
@{
    ViewData["Title"] = "Donation Records Management";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">Donation Records & Audit</h2>
        <p class="text-muted small mb-0">Search, filter, inspect payment proof, and verify philanthropic contributions.</p>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export & Reports
        </a>
    </div>
</div>

<!-- Quick Filter Tabs -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="btn btn-sm @(!Model.SelectedStatus.HasValue ? "btn-primary fw-semibold" : "btn-outline-secondary")">
        All Records
    </a>
    <a asp-area="Admin" asp-controller="Donations" asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending ? "btn-warning text-dark fw-bold shadow-sm" : "btn-outline-warning text-warning-emphasis")">
        <i class="bi bi-hourglass-split me-1"></i> Pending Verification
    </a>
    <a asp-area="Admin" asp-controller="Donations" asp-action="Index" asp-route-status="Paid" class="btn btn-sm @(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid ? "btn-success fw-bold shadow-sm" : "btn-outline-success")">
        <i class="bi bi-check2-circle me-1"></i> Paid & Verified
    </a>
    <a asp-area="Admin" asp-controller="Donations" asp-action="Index" asp-route-status="Refunded" class="btn btn-sm @(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded ? "btn-danger fw-bold shadow-sm" : "btn-outline-danger")">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Refunded
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm p-3 p-sm-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Donations" asp-action="Index" class="row g-2 g-md-3 align-items-end">
        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label small fw-semibold">Search Keyword / Ref #</label>
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Name, Email, Receipt, Tx..." />
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <label class="form-label small fw-semibold">Cause</label>
            <select name="causeId" class="form-select form-select-sm">
                <option value="">All Causes</option>
                @foreach (var c in Model.Causes)
                {
                    <option value="@c.Id" selected="@(Model.SelectedCauseId == c.Id)">@c.Title</option>
                }
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
            <label class="form-label small fw-semibold">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Paid" selected="@(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid)">Paid</option>
                <option value="Pending" selected="@(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending)">Pending</option>
                <option value="Refunded" selected="@(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded)">Refunded</option>
                <option value="Failed" selected="@(Model.SelectedStatus == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Failed)">Failed</option>
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
            <label class="form-label small fw-semibold">Payment Gateway</label>
            <select name="paymentMethod" class="form-select form-select-sm">
                <option value="">All Gateways</option>
                <option value="JazzCash" selected="@(Model.SelectedPaymentMethod == "JazzCash")">JazzCash</option>
                <option value="Easypaisa" selected="@(Model.SelectedPaymentMethod == "Easypaisa")">Easypaisa</option>
                <option value="Card" selected="@(Model.SelectedPaymentMethod == "Card" || Model.SelectedPaymentMethod == "CreditCard")">Credit / Debit Card</option>
                <option value="BankTransfer" selected="@(Model.SelectedPaymentMethod == "BankTransfer")">Bank Transfer / Manual</option>
            </select>
        </div>

        <div class="col-12 col-md-4 col-xl-2 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1 fw-semibold">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="btn btn-outline-secondary btn-sm flex-shrink-0" title="Clear Filters">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

@if (!Model.Donations.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted mb-4">
        No donation records found for this criteria.
    </div>
}
else
{
    <!-- Mobile card list (< md) -->
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var d in Model.Donations)
        {
            var lastTxn = d.PaymentTransactions.LastOrDefault();
            bool hasScreenshot = !string.IsNullOrEmpty(lastTxn?.GatewayRawResponse) && lastTxn.GatewayRawResponse.Contains("proofFilePath");
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="min-w-0">
                        <div class="fw-bold">@(d.IsAnonymous ? "Anonymous Donor" : d.DonorName)</div>
                        <small class="text-muted text-break">@d.DonorEmail</small>
                    </div>
                    @switch (d.Status)
                    {
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid:
                            <span class="badge bg-success flex-shrink-0">Paid</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded:
                            <span class="badge bg-danger flex-shrink-0">Refunded</span>
                            break;
                        case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending:
                            <span class="badge bg-warning text-dark flex-shrink-0">Pending</span>
                            break;
                        default:
                            <span class="badge bg-secondary flex-shrink-0">@d.Status</span>
                            break;
                    }
                </div>
                <div class="admin-mobile-meta mb-3">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Receipt</span>
                        <span class="admin-mobile-value"><code>@(d.Receipt?.ReceiptNumber ?? $"#DON-{d.Id:D6}")</code></span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Amount</span>
                        <span class="admin-mobile-value fw-bold text-success">@d.Currency @d.Amount.ToString("N0")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Cause</span>
                        <span class="admin-mobile-value">@(d.Cause?.Title ?? "General Relief")</span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Payment</span>
                        <span class="admin-mobile-value"><span class="badge bg-light text-dark border">@d.PaymentMethod</span></span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Proof</span>
                        <span class="admin-mobile-value">
                            @if (hasScreenshot)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-image me-1"></i> Slip</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Date</span>
                        <span class="admin-mobile-value text-muted small">@d.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="d-grid">
                    @if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending)
                    {
                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-warning text-dark fw-bold">
                            <i class="bi bi-shield-check me-1"></i> Review & Verify
                        </a>
                    }
                    else
                    {
                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> Details
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Desktop / tablet table -->
    <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Receipt #</th>
                        <th>Donor Name</th>
                        <th>Cause</th>
                        <th>Amount</th>
                        <th>Payment Channel</th>
                        <th>Proof</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Donations)
                    {
                        var lastTxn = d.PaymentTransactions.LastOrDefault();
                        bool hasScreenshot = !string.IsNullOrEmpty(lastTxn?.GatewayRawResponse) && lastTxn.GatewayRawResponse.Contains("proofFilePath");
                        <tr>
                            <td>
                                <code>@(d.Receipt?.ReceiptNumber ?? $"#DON-{d.Id:D6}")</code>
                            </td>
                            <td>
                                <div class="fw-semibold">@(d.IsAnonymous ? "Anonymous Donor" : d.DonorName)</div>
                                <small class="text-muted">@d.DonorEmail</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@(d.Cause?.Title ?? "General Relief")</div>
                            </td>
                            <td class="fw-bold text-success text-nowrap">@d.Currency @d.Amount.ToString("N0")</td>
                            <td>
                                <span class="badge bg-light text-dark border">@d.PaymentMethod</span>
                            </td>
                            <td>
                                @if (hasScreenshot)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-image me-1"></i> Slip</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-muted small text-nowrap">@d.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @switch (d.Status)
                                {
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Paid:
                                        <span class="badge bg-success">Paid</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Refunded:
                                        <span class="badge bg-danger">Refunded</span>
                                        break;
                                    case Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending:
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending Verification</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@d.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    @if (d.Status == Give_Aid_NGO_Donation_Management_System.Models.Entities.DonationStatus.Pending)
                                    {
                                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-warning text-dark fw-bold" title="Review Proof & Verify Donation">
                                            <i class="bi bi-shield-check me-1"></i> Review & Verify
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="Admin" asp-controller="Donations" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary" title="View Full Particulars">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Pagination Footer -->
@if (Model.TotalPages > 1)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 py-3">
            <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total records)</small>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Donations" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-causeId="@Model.SelectedCauseId" asp-route-status="@Model.SelectedStatus"
                           asp-route-paymentMethod="@Model.SelectedPaymentMethod">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="Donations" asp-action="Index"
                               asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-causeId="@Model.SelectedCauseId" asp-route-status="@Model.SelectedStatus"
                               asp-route-paymentMethod="@Model.SelectedPaymentMethod">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Donations" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-causeId="@Model.SelectedCauseId" asp-route-status="@Model.SelectedStatus"
                           asp-route-paymentMethod="@Model.SelectedPaymentMethod">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}
