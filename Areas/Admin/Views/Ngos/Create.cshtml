@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.NgoFormViewModel
@{
    ViewData["Title"] = "Register Partner NGO";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Ngos" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to NGOs
    </a>
    <h2 class="fw-bold mb-1">Register Partner NGO</h2>
    <p class="text-muted small">Onboard a verified NGO into Give-AID's transparent execution network.</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm p-3 p-sm-4">
            <form asp-area="Admin" asp-controller="Ngos" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Hope For All Foundation" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RegistrationNumber" class="form-label fw-semibold"></label>
                        <input asp-for="RegistrationNumber" class="form-control" placeholder="e.g. NGO-ISB-2018-994" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="contact@ngo.org" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+92-300-1234567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label fw-semibold">Website (Optional)</label>
                        <input asp-for="Website" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EstablishedYear" class="form-label fw-semibold"></label>
                        <input asp-for="EstablishedYear" type="number" class="form-control" />
                        <span asp-validation-for="EstablishedYear" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Lahore, Karachi, Islamabad" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Country" class="form-label fw-semibold"></label>
                        <input asp-for="Country" class="form-control" value="Pakistan" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" placeholder="Complete Street / Office Address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Overview of NGO missions, key sectors, and field capacity..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LogoUrl" class="form-label fw-semibold">Or Logo URL</label>
                        <input asp-for="LogoUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Priority</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                    </div>

                    <div class="col-md-4 d-flex align-items-center mt-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Is Active</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4"><div class="admin-form-actions"><button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Register NGO
                        </button><a asp-area="Admin" asp-controller="Ngos" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
