@model Give_Aid_NGO_Donation_Management_System.Areas.Admin.ViewModels.AuditLogsViewModel
@{
    ViewData["Title"] = "System Security & Audit Trail";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 admin-page-header">
    <div class="min-w-0">
        <h2 class="fw-bold mb-1">System Audit & Security Logs</h2>
        <p class="text-muted small mb-0">Immutable compliance log of critical administrator actions, refunds, logins, and entity updates.</p>
    </div>
</div>

<div class="card border-0 shadow-sm p-3 p-sm-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="row g-2 g-md-3 align-items-end">
        <div class="col-12 col-sm-6 col-lg-4">
            <label class="form-label small fw-semibold">Search Details or Email</label>
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search keywords..." />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label small fw-semibold">Action Category</label>
            <input type="text" name="actionFilter" value="@Model.ActionFilter" class="form-control form-control-sm" placeholder="e.g. Login, Refund, Update..." />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label small fw-semibold">Entity Type</label>
            <input type="text" name="entityFilter" value="@Model.EntityFilter" class="form-control form-control-sm" placeholder="e.g. Donation, User..." />
        </div>
        <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="btn btn-outline-secondary btn-sm flex-shrink-0" title="Clear Filters">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

@if (!Model.Logs.Any())
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted mb-4">No audit logs matching this query.</div>
}
else
{
    <div class="d-md-none d-flex flex-column gap-3 mb-4">
        @foreach (var log in Model.Logs)
        {
            <div class="admin-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <span class="badge bg-light text-dark border">@log.Action</span>
                    <small class="text-muted flex-shrink-0">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
                <div class="fw-semibold mb-2">@(string.IsNullOrEmpty(log.UserEmail) ? "System / Guest" : log.UserEmail)</div>
                <p class="small mb-3">@log.Details</p>
                <div class="admin-mobile-meta">
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">Entity</span>
                        <span class="admin-mobile-value"><span class="badge bg-primary-subtle text-primary">@log.EntityType</span> <code>@(string.IsNullOrEmpty(log.EntityId) ? "-" : log.EntityId)</code></span>
                    </div>
                    <div class="admin-mobile-row">
                        <span class="admin-mobile-label">IP</span>
                        <span class="admin-mobile-value"><code>@(string.IsNullOrEmpty(log.IpAddress) ? "127.0.0.1" : log.IpAddress)</code></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none d-md-block">
        <div class="table-responsive admin-table-wrap">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>User / Operator</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Record ID</th>
                        <th>IP Address</th>
                        <th>Audit Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrEmpty(log.UserEmail) ? "System / Guest" : log.UserEmail)</div>
                                <small class="text-muted font-monospace">@(log.UserId ?? "-")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@log.Action</span>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary">@log.EntityType</span></td>
                            <td><code>@(string.IsNullOrEmpty(log.EntityId) ? "-" : log.EntityId)</code></td>
                            <td><code>@(string.IsNullOrEmpty(log.IpAddress) ? "127.0.0.1" : log.IpAddress)</code></td>
                            <td>@log.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 py-3">
            <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total log entries)</small>
            <nav aria-label="Audit pagination">
                <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-actionFilter="@Model.ActionFilter" asp-route-entityFilter="@Model.EntityFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"
                               asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-actionFilter="@Model.ActionFilter" asp-route-entityFilter="@Model.EntityFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-actionFilter="@Model.ActionFilter" asp-route-entityFilter="@Model.EntityFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}
