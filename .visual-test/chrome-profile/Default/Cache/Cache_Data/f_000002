/* Global Shared Tokens */
:root {
    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.06);
    --shadow-sm: 0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 12px 24px -6px rgba(15, 23, 42, 0.1), 0 4px 8px -4px rgba(15, 23, 42, 0.06);
    --shadow-lg: 0 20px 40px -10px rgba(15, 23, 42, 0.12), 0 8px 16px -8px rgba(15, 23, 42, 0.08);
    --shadow-xl: 0 28px 56px -14px rgba(15, 23, 42, 0.16);
    --shadow-glow: 0 0 24px var(--primary-glow);
    --shadow-glow-gold: 0 0 24px var(--accent-glow);
    --shadow-3d-card: 0 16px 32px -12px rgba(15, 23, 42, 0.14), 0 0 0 1px rgba(13, 148, 136, 0.08);

    --radius-xs: 6px;
    --radius-sm: 10px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --radius-full: 9999px;

    --trans-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    --trans-normal: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    --trans-smooth: 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    --trans-spring: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ==========================================================================
   Base & Typography (Zero Horizontal Overflow, Fluid Scaling)
   ========================================================================== */
*, *::before, *::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--bg-body);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

body {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-secondary);
    background-color: var(--bg-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    position: relative;
}

/* Fluid Media & Containers */
img, video, iframe, svg, canvas {
    max-width: 100%;
    height: auto;
    display: inline-block;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
    width: 9px;
    height: 9px;
}

::-webkit-scrollbar-track {
    background: #f1f5f9;
}

::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 6px;
    border: 2px solid #f1f5f9;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--primary);
}

* {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f1f5f9;
}

/* Typography & Headings */
h1, h2, h3, h4, h5, h6, .font-heading {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    overflow-wrap: break-word;
    word-break: normal;
}

.display-1 { font-size: clamp(2rem, 5vw, 4.25rem); font-weight: 800; line-height: 1.15; }
.display-2 { font-size: clamp(1.85rem, 4.5vw, 3.75rem); font-weight: 800; line-height: 1.18; }
.display-3 { font-size: clamp(1.65rem, 4vw, 3.25rem); font-weight: 800; line-height: 1.2; }
.display-4 { font-size: clamp(1.5rem, 3.5vw, 2.75rem); font-weight: 800; line-height: 1.22; }
.display-5 { font-size: clamp(1.35rem, 3vw, 2.25rem); font-weight: 800; line-height: 1.25; }
.display-6 { font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 800; line-height: 1.3; }

h1 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
h2 { font-size: clamp(1.35rem, 2.5vw, 1.85rem); }
h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
h4 { font-size: clamp(1.05rem, 1.75vw, 1.3rem); }
h5 { font-size: clamp(0.95rem, 1.5vw, 1.15rem); }
h6 { font-size: clamp(0.85rem, 1.25vw, 1rem); }

.lead {
    font-size: clamp(0.95rem, 1.5vw, 1.18rem);
    line-height: 1.75;
}

.text-dark {
    color: var(--text-primary) !important;
}

.text-muted {
    color: var(--text-muted) !important;
}

.text-secondary {
    color: var(--text-secondary) !important;
}

.text-gradient-emerald, .text-gradient {
    background: var(--grad-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

.text-gradient-gold {
    background: var(--grad-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

.text-gradient-neon {
    background: var(--grad-primary-neon);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

code, pre, .font-mono {
    font-family: 'JetBrains Mono', monospace;
    color: var(--primary-light);
    background-color: rgba(16, 185, 129, 0.12);
    padding: 0.18em 0.45em;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(16, 185, 129, 0.2);
    word-break: break-word;
}

pre {
    padding: 1.2rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-darkest);
    overflow-x: auto;
}

main {
    flex: 1 0 auto;
    width: 100%;
    min-width: 0;
}

::selection {
    background-color: rgba(16, 185, 129, 0.4);
    color: #ffffff;
}

/* ==========================================================================
   Top Scroll Progress Bar
   ========================================================================== */
#scrollProgressBar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3.5px;
    background: linear-gradient(90deg, var(--teal), var(--primary), var(--accent-light));
    z-index: 1080;
    width: 0%;
    transition: width 0.08s ease;
    box-shadow: 0 0 12px var(--primary-glow);
}

/* ==========================================================================
   Emergency Live Appeal Topbar
   ========================================================================== */
.topbar-emergency {
    background: linear-gradient(90deg, #f0fdfa 0%, #ecfeff 50%, #eff6ff 100%);
    border-bottom: 1px solid #ccfbf1;
    font-size: 0.84rem;
    padding: 0.45rem 0;
    color: #334155;
    position: relative;
    z-index: 1045;
}

.topbar-emergency a {
    color: #0f766e;
    transition: all var(--trans-fast);
}

.topbar-emergency a:hover {
    color: var(--primary-dark);
    transform: translateY(-1px);
}

.pulse-badge {
    animation: pulseBadge 2.2s infinite ease-in-out;
}

@keyframes pulseBadge {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    50% { opacity: 0.85; transform: scale(0.97); box-shadow: 0 0 12px 2px rgba(239, 68, 68, 0.3); }
}

/* ==========================================================================
   MASTER NAVBAR & FROSTED GLASS HEADER
   ========================================================================== */
header.sticky-top {
    z-index: 1040;
}

.navbar-giveaid {
    background: var(--bg-glass);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border-bottom: 1px solid var(--border-color);
    padding: 0.65rem 0;
    transition: all var(--trans-normal);
    position: relative;
}

.navbar-giveaid::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--primary-glow) 50%, transparent 100%);
    pointer-events: none;
}

.navbar-giveaid.scrolled {
    background: rgba(7, 13, 30, 0.97);
    padding: 0.45rem 0;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.75), 0 0 18px var(--primary-subtle);
    border-bottom-color: var(--border-glow-primary);
}

/* Brand Emblem with 3D Heartbeat Pulse */
.navbar-brand {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.3rem;
    color: #ffffff !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    text-decoration: none;
    transition: transform var(--trans-fast);
}

.navbar-brand:hover {
    transform: scale(1.02);
}

.navbar-brand .brand-badge {
    background: var(--grad-primary);
    color: white;
    padding: 5px 11px;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    font-weight: 800;
    box-shadow: 0 4px 15px var(--primary-glow);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
}

.navbar-brand .brand-badge::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(60deg, transparent 40%, rgba(255, 255, 255, 0.25) 50%, transparent 60%);
    transform: rotate(30deg);
    animation: shineSweep 4s infinite linear;
}

.navbar-brand .brand-badge i {
    color: #ffd166;
    animation: heartbeat3d 1.8s infinite ease-in-out;
    display: inline-block;
}

@keyframes heartbeat3d {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.25) rotate(-5deg); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15) rotate(3deg); }
    60% { transform: scale(1); }
}

/* Desktop Navigation Links */
.navbar-giveaid .nav-link {
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--text-secondary) !important;
    padding: 0.42rem 0.62rem !important;
    border-radius: var(--radius-sm);
    transition: all var(--trans-fast);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    position: relative;
}

.navbar-giveaid .nav-link i {
    font-size: 0.92rem;
    color: var(--text-muted);
    transition: color var(--trans-fast), transform var(--trans-fast);
}

.navbar-giveaid .nav-link:hover {
    color: #ffffff !important;
    background-color: var(--primary-subtle);
