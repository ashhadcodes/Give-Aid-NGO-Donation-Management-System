}

/* ==========================================================================
   PREMIUM 3D BUTTONS & TACTILE DEPTH
   ========================================================================== */
.btn-warning, .btn-3d-gold {
    background: var(--grad-accent) !important;
    color: #0b1329 !important;
    font-weight: 700 !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--accent-glow), 0 2px 0 var(--accent-dark);
    position: relative;
    overflow: hidden;
    transition: all var(--trans-fast);
    transform-style: preserve-3d;
}

.btn-warning:hover, .btn-3d-gold:hover {
    color: #000000 !important;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px var(--accent-glow), 0 4px 0 var(--accent-dark);
}

.btn-warning:active, .btn-3d-gold:active {
    transform: translateY(2px) scale(0.98);
    box-shadow: 0 2px 6px var(--accent-glow), 0 0 0 var(--accent-dark);
}

.btn-primary, .btn-3d-emerald {
    background: var(--grad-primary) !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--primary-glow), 0 2px 0 var(--primary-dark);
    position: relative;
    overflow: hidden;
    transition: all var(--trans-fast);
    transform-style: preserve-3d;
}

.btn-primary:hover, .btn-3d-emerald:hover {
    color: #ffffff !important;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px var(--primary-glow), 0 4px 0 var(--primary-dark);
}

.btn-primary:active, .btn-3d-emerald:active {
    transform: translateY(2px) scale(0.98);
    box-shadow: 0 2px 6px var(--primary-glow), 0 0 0 var(--primary-dark);
}

.btn-outline-primary {
    color: var(--primary-light) !important;
    border-color: var(--border-glow-primary) !important;
    background: var(--primary-subtle);
    border-radius: var(--radius-sm);
    transition: all var(--trans-fast);
}

.btn-outline-primary:hover {
    color: #ffffff !important;
    background: var(--primary) !important;
    border-color: var(--primary) !important;
    box-shadow: 0 4px 16px var(--primary-glow);
    transform: translateY(-2px);
}

.btn-outline-secondary, .btn-outline-light {
    color: var(--text-secondary) !important;
    border-color: var(--border-light) !important;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-sm);
    transition: all var(--trans-fast);
}

.btn-outline-secondary:hover, .btn-outline-light:hover {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
    transform: translateY(-2px);
}

/* Button Pulse Animation */
.btn-pulse {
    animation: btnPulseGlow 2.5s infinite ease-in-out;
}

@keyframes btnPulseGlow {
    0%, 100% { box-shadow: 0 4px 14px var(--accent-glow); }
    50% { box-shadow: 0 0 26px 4px var(--accent-glow); }
}

/* Button Shine Sweep Effect */
.shine-sweep-hover {
    position: relative;
    overflow: hidden;
}

.shine-sweep-hover::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -60%;
    width: 20%;
    height: 200%;
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(30deg);
    transition: all 0.6s ease;
}

.shine-sweep-hover:hover::after {
    left: 140%;
}

/* ==========================================================================
   RESPONSIVE CARD GRID & BALANCED NGO CARDS (DESKTOP: 4, TABLET: 2, MOBILE: 1)
   ========================================================================== */
.card-grid-responsive,
.responsive-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
}

@media (max-width: 1199.98px) {
    .card-grid-responsive,
    .responsive-card-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
    }
}

@media (max-width: 767.98px) {
    .card-grid-responsive,
    .responsive-card-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

.card, .glass-card, .quick-donate-card, .step-card, .stat-box-modern, .donate-card, .program-card, .ngo-card, .cause-card, .partner-card, .about-card, .gallery-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    transition: all var(--trans-normal);
    position: relative;
}

/* Balanced Card Container Rules (Compact, Proportional, Zero Overflow Blowouts) */
.cause-card,
.program-card,
.ngo-card,
.partner-card,
.about-card,
.gallery-card {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-md, 0.75rem);
}

/* Card Image Containers - Controlled 16:9 Aspect Ratio */
.card-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
    overflow: hidden;
    background-color: var(--bg-surface-elevated);
}

.card-img-wrapper img,
.card-img-wrapper .card-img-top,
.cause-card .card-img-top,
.program-card .card-img-top {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--trans-smooth);
}

.card-hover:hover .card-img-wrapper img,
.card-hover:hover .card-img-top {
    transform: scale(1.04);
}

/* Badge Overlay with Zero Overlap */
.card-badge-overlay {
    pointer-events: none;
    z-index: 2;
}

/* Card Body Proportions (Compact, Professional Spacing) */
.cause-card .card-body,
.program-card .card-body,
.ngo-card .card-body,
.partner-card .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.15rem 1.25rem;
}

/* Clean Typography - Natural Wrapping, Zero Truncation */
.cause-card h5,
.program-card h5,
.cause-card .card-title,
.program-card .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    word-break: break-word;
}

.cause-card p,
.program-card p {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    word-break: break-word;
}

/* Progress Wrapper & Metrics */
.cause-progress-wrapper {
    margin-top: auto;
    margin-bottom: 0.85rem;
    width: 100%;
}

.cause-progress-wrapper .progress,
.progress-giveaid {
    height: 6px !important;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

/* Compact, Balanced Action Buttons */
.cause-card .btn,
.program-card .btn {
    width: 100%;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm, 0.5rem);
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
}

.card:hover, .card-hover:hover {
    border-color: var(--border-glow-primary);
    box-shadow: var(--shadow-3d-card);
    transform: translateY(-4px);
}

/* Gallery Cards - Controlled 16:9 Aspect Ratio */
.gallery-card {
    width: 100%;
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.gallery-card-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-surface-elevated);
}

.gallery-card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--trans-smooth);
}

.gallery-card:hover .gallery-card-img-wrapper img {
    transform: scale(1.04);
}

/* NGO & Partner Cards - Compact, Balanced Spacing */
.ngo-card, .partner-card {
    padding: 1.25rem 1.15rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-align: center;
    border-radius: var(--radius-md, 0.75rem);
}

.ngo-card img, .partner-card img {
    max-width: 80px;
    max-height: 80px;
    object-fit: cover;
}

/* 3D Tilt Card Base Container */
.tilt-card-3d, .card-hover, .step-card, .stat-box-modern, .quick-donate-card, .cause-card, .program-card, .ngo-card, .partner-card {
    transform-style: preserve-3d;
    perspective: 1200px;
    will-change: transform;
}

/* 3D Card Inner Child Parallax Depth */
.card-3d-content, .card-body, .stat-icon {
    transform-style: preserve-3d;
    transition: transform var(--trans-normal);
}

.tilt-card-3d:hover .card-3d-depth-1 {
    transform: translateZ(20px);
}

.tilt-card-3d:hover .card-3d-depth-2 {
    transform: translateZ(35px);
}

/* Specular Glare Layer for 3D Cards */
.tilt-glare-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    transition: opacity var(--trans-normal);
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.12), transparent 70%);
}

.tilt-card-3d:hover .tilt-glare-layer {
    opacity: 1;
}

/* Hero Quick Donate Card */
.quick-donate-card {
    background: linear-gradient(145deg, rgba(16, 26, 53, 0.95) 0%, rgba(10, 16, 36, 0.98) 100%);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-xl);
    padding: 1.8rem;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.75), 0 0 30px rgba(16, 185, 129, 0.2);
    backdrop-filter: blur(20px);
}

.amount-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.5rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--trans-fast);
}

.amount-chip:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: var(--primary-light);
    transform: translateY(-2px);
}

.amount-chip.active {
    background: var(--grad-primary);
    border-color: var(--primary-neon);
    color: #ffffff;
    box-shadow: 0 4px 14px var(--primary-glow);
    transform: translateY(-2px) scale(1.02);
}

/* Real-Time Modern Stat Counter Boxes */
.stat-box-modern {
    background: linear-gradient(145deg, rgba(16, 26, 53, 0.8) 0%, rgba(10, 16, 36, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 1.4rem 1.2rem;
    text-align: center;
    backdrop-filter: blur(15px);
    transition: all var(--trans-normal);
}

.stat-box-modern:hover {
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5), 0 0 20px rgba(16, 185, 129, 0.2);
    transform: translateY(-5px);
}

.stat-box-modern .stat-icon {
    font-size: 2rem;
    color: var(--accent-light);
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 4px 10px rgba(245, 158, 11, 0.3));
