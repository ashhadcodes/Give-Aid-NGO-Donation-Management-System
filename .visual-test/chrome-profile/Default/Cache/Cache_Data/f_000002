/* ==========================================================================
   GIVE-AID NGO WELFARE & DONATION MANAGEMENT SYSTEM
   MASTER 2026 LUXURY THEME ENGINE + INTELLIGENT RESPONSIVE NAVBAR SYSTEM
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap');

/* ==========================================================================
   1. DYNAMIC THEME SYSTEM (4 LUXURY 2026 THEMES)
   ========================================================================== */

[data-theme="emerald"] {
    /* 1. CYBER EMERALD (OPTIONAL DARK THEME) */
    --theme-name: "Cyber Emerald";
    --primary: #10b981;             /* Radiant Emerald */
    --primary-light: #34d399;       /* Mint Glow */
    --primary-lighter: #6ee7b7;
    --primary-neon: #00f5a0;
    --primary-dark: #059669;
    --primary-darker: #047857;
    --primary-glow: rgba(16, 185, 129, 0.45);
    --primary-subtle: rgba(16, 185, 129, 0.12);

    --teal: #14b8a6;
    --teal-dark: #0d9488;
    --teal-glow: rgba(20, 184, 166, 0.4);

    --accent: #f59e0b;              /* Warm Amber Gold */
    --accent-light: #fbbf24;
    --accent-gold: #ffd166;
    --accent-dark: #d97706;
    --accent-glow: rgba(245, 158, 11, 0.45);
    --accent-subtle: rgba(245, 158, 11, 0.15);

    /* Deep Navy & Midnight Surfaces */
    --bg-void: #050811;
    --bg-darkest: #070d1e;
    --bg-body: #0a1128;             /* Rich Deep Navy */
    --bg-surface: #0f1a38;          /* Midnight Navy Surface */
    --bg-surface-elevated: #15244d;  /* Elevated Navy */
    --bg-surface-hover: #1b2d5e;
    --bg-input: #0a132c;
    --bg-glass: rgba(15, 26, 56, 0.88);
    --bg-glass-card: rgba(17, 29, 62, 0.92);

    /* Typography */
    --text-primary: #ffffff;
    --text-secondary: #e2e8f0;
    --text-muted: #94a3b8;
    --text-light: #64748b;
    --text-white: #ffffff;

    /* Borders & Glows */
    --border-color: rgba(255, 255, 255, 0.09);
    --border-light: rgba(255, 255, 255, 0.15);
    --border-glass: rgba(255, 255, 255, 0.14);
    --border-glow-primary: rgba(16, 185, 129, 0.4);
    --border-glow-gold: rgba(245, 158, 11, 0.4);

    /* Gradients */
    --grad-primary: linear-gradient(135deg, #0d9488 0%, #10b981 50%, #34d399 100%);
    --grad-primary-neon: linear-gradient(135deg, #059669 0%, #00f5a0 100%);
    --grad-hero: linear-gradient(135deg, #04141c 0%, #08282b 35%, #0a1128 100%);
    --grad-dark: linear-gradient(145deg, #070d1e 0%, #0a1128 50%, #0f1a38 100%);
    --grad-accent: linear-gradient(135deg, #d97706 0%, #f59e0b 50%, #ffd166 100%);
    --grad-card: linear-gradient(180deg, rgba(17, 29, 62, 0.95) 0%, rgba(10, 18, 40, 0.98) 100%);
}

