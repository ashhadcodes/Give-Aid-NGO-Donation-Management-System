/* 4-Step Journey Cards */
.step-card {
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-darkest) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.8rem 1.5rem;
    position: relative;
    height: 100%;
}

.step-number {
    width: 42px;
    height: 42px;
    background: var(--grad-primary);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.1rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px var(--primary-glow);
    margin-bottom: 1.2rem;
}

/* ==========================================================================
   FLOATING 3D ANIMATION KEYFRAMES
   ========================================================================== */
.float-3d {
    animation: float3dAnimation 4s infinite ease-in-out;
}

.float-3d-delayed {
    animation: float3dAnimation 4.5s infinite ease-in-out 1.2s;
}

@keyframes float3dAnimation {
    0%, 100% {
        transform: translateY(0px) rotateX(0deg) rotateY(0deg);
    }
    50% {
        transform: translateY(-10px) rotateX(3deg) rotateY(-3deg);
    }
}

@keyframes shineSweep {
    0% { transform: translateX(-150%) rotate(30deg); }
    30%, 100% { transform: translateX(250%) rotate(30deg); }
}

/* ==========================================================================
   HERO SECTION & 3D CANVAS STYLES
   ========================================================================== */
.hero-wrapper {
    background: var(--grad-hero);
    min-height: clamp(420px, 62vh, 640px);
    display: flex;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    position: relative;
}

.hero-mesh-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 18% 28%, rgba(13, 148, 136, 0.1) 0%, transparent 48%),
                radial-gradient(circle at 82% 72%, rgba(245, 158, 11, 0.07) 0%, transparent 42%);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 2;
}

/* ==========================================================================
   FLOATING ACTION BUTTONS (FAST DONATE & BACK TO TOP)
   ========================================================================== */
.fab-donate-floating {
    position: fixed;
    bottom: 25px;
    right: 25px;
    background: var(--grad-accent);
    color: #0b1329 !important;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 10px 25px var(--accent-glow), 0 4px 0 #b45309;
    z-index: 1030;
    text-decoration: none;
    transition: all var(--trans-spring);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.fab-donate-floating:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 15px 35px var(--accent-glow), 0 6px 0 #b45309;
    color: #000000 !important;
}

.fab-donate-floating:active {
    transform: translateY(2px) scale(0.96);
}

.back-to-top {
    position: fixed;
    bottom: 25px;
    left: 25px;
    width: 44px;
    height: 44px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-light);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all var(--trans-normal);
    z-index: 1030;
    box-shadow: var(--shadow-md);
}

.back-to-top.visible {
    opacity: 1;
    visibility: visible;
}

.back-to-top:hover {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 4px 16px var(--primary-glow);
    transform: translateY(-3px);
}

/* ==========================================================================
   LUXURY FORM CONTROLS & INPUTS
   ========================================================================== */
.form-control, .form-select {
    background-color: var(--bg-input) !important;
    border: 1px solid var(--border-light) !important;
    color: var(--text-primary) !important;
    border-radius: var(--radius-sm) !important;
    padding: 0.65rem 0.95rem;
    font-size: 0.92rem;
    transition: all var(--trans-fast);
}

.form-control:focus, .form-select:focus {
    background-color: var(--bg-surface) !important;
    border-color: var(--primary-light) !important;
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.2) !important;
    color: var(--text-primary) !important;
}

.form-control::placeholder {
    color: var(--text-light);
}

.input-group-text {
    background-color: var(--bg-surface-elevated) !important;
    border-color: var(--border-light) !important;
    color: var(--text-secondary) !important;
    font-weight: 600;
}

.form-label {
    color: var(--text-secondary);
    font-weight: 600;
    margin-bottom: 0.35rem;
}

/* ==========================================================================
   BADGES & PILLS
   ========================================================================== */
.badge {
    padding: 0.4em 0.75em;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: var(--radius-xs);
}

.badge.bg-success, .badge.bg-success-subtle {
    background-color: rgba(16, 185, 129, 0.14) !important;
    color: #047857 !important;
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge.bg-warning, .badge.bg-warning-subtle {
    background-color: rgba(245, 158, 11, 0.16) !important;
    color: #92400e !important;
    border: 1px solid rgba(245, 158, 11, 0.35);
}

.badge.bg-danger, .badge.bg-danger-subtle {
    background-color: rgba(239, 68, 68, 0.12) !important;
    color: #b91c1c !important;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge.bg-primary, .badge.bg-primary-subtle {
    background-color: rgba(37, 99, 235, 0.12) !important;
    color: #1d4ed8 !important;
    border: 1px solid rgba(37, 99, 235, 0.3);
}

/* ==========================================================================
   TABLES & DATA DISPLAY
   ========================================================================== */
.table {
    color: var(--text-secondary) !important;
    --bs-table-bg: transparent;
    --bs-table-striped-bg: rgba(255, 255, 255, 0.02);
